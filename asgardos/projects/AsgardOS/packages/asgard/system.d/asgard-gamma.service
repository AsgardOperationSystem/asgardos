[Unit]
Description=Asgard: per-screen white balance (Settings > Display)
After=essway.service

[Service]
Environment=XDG_RUNTIME_DIR=/var/run/0-runtime-dir WAYLAND_DISPLAY=wayland-1
ExecStart=/usr/bin/asgard-gamma
Restart=always
RestartSec=5

[Install]
# asgardos.target, like essway (see thor-idle-blank.service)
WantedBy=asgardos.target
