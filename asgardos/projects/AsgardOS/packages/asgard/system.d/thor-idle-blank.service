[Unit]
Description=Thor OLED guard: screens off after 5 min without input
After=essway.service

[Service]
Environment=IDLE_SECONDS=300
ExecStart=/usr/bin/python3 /usr/share/asgard/thor-idle-blank.py
Restart=always
RestartSec=5

[Install]
# asgardos.target, like essway: multi-user.target comes before sway/essway, so ordering After=essway there loops.
WantedBy=asgardos.target
