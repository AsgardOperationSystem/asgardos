# The Asgard frontend. Named essway.service because ROCKNIX's sway init, UI_SERVICE quirk, sway-touch and
# restart scripts all address the frontend by this unit name; ROCKNIX ES itself is not in the image.
[Unit]
Description=Asgard frontend
Requires=sway.service
After=sway.service

[Service]
Type=simple
Environment=HOME=/storage
EnvironmentFile=/etc/profile
ExecStart=/usr/share/asgard/start_frontend.sh
WorkingDirectory=/storage
Restart=always
RestartSec=2

[Install]
WantedBy=asgardos.target
