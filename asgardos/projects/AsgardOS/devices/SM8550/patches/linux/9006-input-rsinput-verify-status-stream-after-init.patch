From: Chaos Ruler <zmelumian@gmail.com>
Subject: [PATCH] input: rsinput: verify the MCU's status stream after init, redo it when stalled

On an AYN Thor resume (2026-10-10) the version handshake timed out once; the
late reply to that attempt then arrived together with the retry's, the params
command was acked ~1 s later, and the MCU was left streaming status frames at
~1/s instead of ~90/s. Every press was only seen once a second, so it looked
held and frontends auto-repeated it; nothing short of re-probing the driver
recovered it.

After the params command, count CMD_STATUS frames over 100 ms (after a 50 ms
settle). Fewer than 3 means the stream stalled: redo the whole power-on,
version handshake and params sequence, up to 3 times. Adds ~150 ms to probe
and resume. The device is kept even if every attempt stalls, so a later resume
can still recover it.

Signed-off-by: Chaos Ruler <zmelumian@gmail.com>
---
diff --git a/drivers/input/joystick/rsinput.c b/drivers/input/joystick/rsinput.c
index a0de8c4a6126..1b1350d7fdad 100644
--- a/drivers/input/joystick/rsinput.c
+++ b/drivers/input/joystick/rsinput.c
@@ -6,6 +6,7 @@
  *
  */
 
+#include <linux/atomic.h>
 #include <linux/completion.h>
 #include <linux/errno.h>
 #include <linux/gpio/consumer.h>
@@ -137,6 +138,17 @@ module_param(axis_righty_antideadzone,int,0660);
  */
 #define MCU_VERSION_ACK_TIMEOUT_MS  500
 #define MCU_INIT_MAX_ATTEMPTS       3
+/*
+ * After the params command the MCU streams status frames at ~90/s even when idle.
+ * An unlucky resume (a late version reply to a timed-out attempt arriving during
+ * the retry, AYN Thor 2026-10-10) left it at ~1 frame/s: presses only seen once a
+ * second, so held and auto-repeated. The stream is checked, and the whole init
+ * redone, rather than trusting the params ack.
+ */
+#define MCU_STREAM_SETTLE_MS        50
+#define MCU_STREAM_WINDOW_MS        100
+#define MCU_STREAM_MIN_FRAMES       3
+#define MCU_STREAM_MAX_ATTEMPTS     3
 
 struct rsinput_driver {
     struct serdev_device *serdev;
@@ -162,6 +174,7 @@ struct rsinput_driver {
      * handshake cannot falsely complete the wait.
      */
     bool version_ack_pending;
+    atomic_t status_frames;   /* CMD_STATUS frames received, for the stream check */
 };
 
 static bool rumble_enable = true;
@@ -245,7 +258,7 @@ static void rsinput_power_on_mcu(struct rsinput_driver *drv) {
         gpiod_set_value_cansleep(drv->reset_gpio, 1);
 }
 
-static int rsinput_init_commands(struct rsinput_driver *drv) {
+static int rsinput_init_once(struct rsinput_driver *drv) {
     static const uint8_t version_request[] = {DATA_COMMOD_VERSION};
     static const uint8_t mcu_params[] = {
         DATA_COMMOD_SET_PAR,
@@ -333,6 +346,33 @@ static int rsinput_init_commands(struct rsinput_driver *drv) {
     return 0;
 }
 
+/*
+ * Bring the MCU up and confirm it is streaming status frames; redo the whole
+ * power-on, handshake and params sequence when the stream stays (nearly) silent.
+ */
+static int rsinput_init_commands(struct rsinput_driver *drv) {
+    int attempt, frames = 0, error = 0;
+
+    for (attempt = 1; attempt <= MCU_STREAM_MAX_ATTEMPTS; attempt++) {
+        error = rsinput_init_once(drv);
+        if (error < 0)
+            return error;
+        msleep(MCU_STREAM_SETTLE_MS);
+        atomic_set(&drv->status_frames, 0);
+        msleep(MCU_STREAM_WINDOW_MS);
+        frames = atomic_read(&drv->status_frames);
+        if (frames >= MCU_STREAM_MIN_FRAMES)
+            return 0;
+        dev_warn(&drv->serdev->dev,
+                 "MCU status stream stalled (%d frames in %d ms), reinitialising (attempt %d/%d)\n",
+                 frames, MCU_STREAM_WINDOW_MS, attempt, MCU_STREAM_MAX_ATTEMPTS);
+    }
+    /* Keep the device: a later resume can still recover it. */
+    dev_err(&drv->serdev->dev, "MCU status stream still stalled after %d attempts\n",
+            MCU_STREAM_MAX_ATTEMPTS);
+    return 0;
+}
+
 static void handle_cmd_commod(struct rsinput_driver *drv, const uint8_t *data, size_t payload_length) {
     switch (data[FRAME_POS_DATA_1]) {
         case DATA_COMMOD_VERSION:
@@ -475,6 +515,7 @@ static void rsinput_process_data(struct rsinput_driver *drv, const uint8_t *data
                 handle_cmd_commod(drv, data, payload_length);
                 break;
             case CMD_STATUS:
+                atomic_inc(&drv->status_frames);
                 handle_cmd_status(drv, data, payload_length);
                 break;
             default:
