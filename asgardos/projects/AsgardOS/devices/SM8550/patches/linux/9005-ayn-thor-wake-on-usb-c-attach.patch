From: ROCKNIX local test <noreply@localhost>
Subject: [PATCH] AYN Thor: wake from s2idle on USB-C attach/detach

Plugging the charger into a sleeping Thor leaves it on the cable but
discharging until reboot. 0502 masks the IPCC mailbox across suspend, so
the ADSP's UCSI connector-change notification is neither delivered nor
acked while asleep, and the PPM stays out of sync after resume.

On ayn,thor only: keep the IPCC irq live across s2idle (IRQF_NO_SUSPEND,
as before 0502), and make ucsi_glink a wakeup source that resumes the
system on a connector-change notification. battmgr notifications still
don't wake the system, they just exit CPU idle briefly.

With the mailbox live, ucsi_glink and pmic_glink_altmode handle USB-C
notifications during suspend, and their workers program dwc3 and the
QMP PHY/mux. Run on system_wq, an unplug while asleep did that with the
devices suspended and reset the SoC. Queue them on system_freezable_wq
so they only run after resume.
---
diff --color -ru a/drivers/mailbox/qcom-ipcc.c b/drivers/mailbox/qcom-ipcc.c
diff --git a/drivers/mailbox/qcom-ipcc.c b/drivers/mailbox/qcom-ipcc.c
index f2e5b9505bfc..a94eab01f405 100644
--- a/drivers/mailbox/qcom-ipcc.c
+++ b/drivers/mailbox/qcom-ipcc.c
@@ -9,6 +9,7 @@
 #include <linux/irqdomain.h>
 #include <linux/mailbox_controller.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 
 #include <dt-bindings/mailbox/qcom-ipcc.h>
@@ -325,9 +326,17 @@ static int qcom_ipcc_probe(struct platform_device *pdev)
 	if (ret)
 		goto err_mbox;
 
+	/*
+	 * AYN Thor: keep the mailbox live across s2idle so pmic_glink still
+	 * delivers (and acks) USB-C attach notifications while asleep; a missed
+	 * attach leaves the charger unhandled until reboot. Delivery alone does
+	 * not resume the system: only ucsi_glink turns a connector change into a
+	 * wakeup, so periodic battmgr chatter stays a brief CPU-idle exit.
+	 */
 	ret = devm_request_irq(&pdev->dev, ipcc->irq, qcom_ipcc_irq_fn,
-			       IRQF_TRIGGER_HIGH |
-			       IRQF_NO_THREAD, name, ipcc);
+			       IRQF_TRIGGER_HIGH | IRQF_NO_THREAD |
+			       (of_machine_is_compatible("ayn,thor") ? IRQF_NO_SUSPEND : 0),
+			       name, ipcc);
 	if (ret < 0)
 		goto err_req_irq;
 
diff --git a/drivers/soc/qcom/pmic_glink_altmode.c b/drivers/soc/qcom/pmic_glink_altmode.c
index 13c434f8d03a..b035d69e0da1 100644
--- a/drivers/soc/qcom/pmic_glink_altmode.c
+++ b/drivers/soc/qcom/pmic_glink_altmode.c
@@ -451,7 +451,8 @@ static void pmic_glink_altmode_sc8180xp_notify(struct pmic_glink_altmode *altmod
 	alt_port->mode = mode;
 	alt_port->hpd_state = hpd_state;
 	alt_port->hpd_irq = hpd_irq;
-	schedule_work(&alt_port->work);
+	/* Freezable: the worker programs the USB-C PHY/mux, which must not run while devices are suspended. */
+	queue_work(system_freezable_wq, &alt_port->work);
 }
 
 #define SC8280XP_DPAM_MASK	0x3f
@@ -502,7 +503,8 @@ static void pmic_glink_altmode_sc8280xp_notify(struct pmic_glink_altmode *altmod
 		alt_port->tbt_data = *tbt;
 	}
 
-	schedule_work(&alt_port->work);
+	/* Freezable: the worker programs the USB-C PHY/mux, which must not run while devices are suspended. */
+	queue_work(system_freezable_wq, &alt_port->work);
 }
 
 static void pmic_glink_altmode_callback(const void *data, size_t len, void *priv)
diff --git a/drivers/usb/typec/ucsi/ucsi_glink.c b/drivers/usb/typec/ucsi/ucsi_glink.c
index 1db0c88d817e..15a6a4a46d3c 100644
--- a/drivers/usb/typec/ucsi/ucsi_glink.c
+++ b/drivers/usb/typec/ucsi/ucsi_glink.c
@@ -6,8 +6,11 @@
 #include <linux/auxiliary_bus.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
+#include <linux/of.h>
 #include <linux/of_device.h>
+#include <linux/pm_wakeup.h>
 #include <linux/property.h>
+#include <linux/suspend.h>
 #include <linux/soc/qcom/pdr.h>
 #include <linux/usb/typec_mux.h>
 #include <linux/gpio/consumer.h>
@@ -342,7 +345,13 @@ static void pmic_glink_ucsi_callback(const void *data, size_t len, void *priv)
 		pmic_glink_ucsi_write_ack(ucsi, data, len);
 		break;
 	case UC_UCSI_USBC_NOTIFY_IND:
-		schedule_work(&ucsi->notify_work);
+		/*
+		 * Thor: a cable change while asleep resumes the system (wakeup source set up in probe). The
+		 * work sets the USB role (dwc3), so it waits on the freezable queue until devices are resumed:
+		 * touching them suspended resets the SoC (seen on unplug while asleep, 2026-10-10).
+		 */
+		pm_wakeup_dev_event(ucsi->dev, 0, pm_suspend_target_state != PM_SUSPEND_ON);
+		queue_work(system_freezable_wq, &ucsi->notify_work);
 		break;
 	}
 }
@@ -405,6 +414,9 @@ static int pmic_glink_ucsi_probe(struct auxiliary_device *adev,
 	ucsi->dev = dev;
 	dev_set_drvdata(dev, ucsi);
 
+	if (of_machine_is_compatible("ayn,thor"))
+		device_init_wakeup(dev, true);
+
 	INIT_WORK(&ucsi->notify_work, pmic_glink_ucsi_notify);
 	INIT_WORK(&ucsi->register_work, pmic_glink_ucsi_register);
 	init_completion(&ucsi->read_ack);
