diff --git a/sound/soc/codecs/lpass-wsa-macro.c b/sound/soc/codecs/lpass-wsa-macro.c
index 38e37908baf9..b42ce5770903 100644
--- a/sound/soc/codecs/lpass-wsa-macro.c
+++ b/sound/soc/codecs/lpass-wsa-macro.c
@@ -2881,6 +2881,7 @@ static int wsa_macro_runtime_resume(struct device *dev)
 }
 
 static const struct dev_pm_ops wsa_macro_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend, pm_runtime_force_resume)
 	RUNTIME_PM_OPS(wsa_macro_runtime_suspend, wsa_macro_runtime_resume, NULL)
 };
 
diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index 644cb0819045..16085ba21a13 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -82,6 +82,8 @@ struct sc8280xp_snd_data {
 	struct snd_soc_jack dp_jack[8];
 	const struct qcom_snd_soc_common *priv;
 	struct clk *i2s_clk;
+	int i2s_clk_count;
+	bool i2s_clk_suspended;
 	bool jack_setup;
 };
 
@@ -225,7 +227,8 @@ static int sc8280xp_snd_startup(struct snd_pcm_substream *substream)
 
 	switch (cpu_dai->id) {
 	case PRIMARY_MI2S_RX:
-		clk_prepare_enable(pdata->i2s_clk);
+		if (pdata->i2s_clk_count++ == 0 && !pdata->i2s_clk_suspended)
+			clk_prepare_enable(pdata->i2s_clk);
 		break;
 	default:
 		break;
@@ -242,7 +245,8 @@ static void sc8280xp_snd_shutdown(struct snd_pcm_substream *substream)
 
 	switch (cpu_dai->id) {
 	case PRIMARY_MI2S_RX:
-		clk_disable_unprepare(pdata->i2s_clk);
+		if (--pdata->i2s_clk_count == 0 && !pdata->i2s_clk_suspended)
+			clk_disable_unprepare(pdata->i2s_clk);
 		break;
 	default:
 		break;
@@ -429,6 +433,39 @@ static void sc8280xp_add_be_ops(struct snd_soc_card *card)
 	}
 }
 
+/*
+ * A PCM still open at suspend keeps the board I2S clock. It is a q6prm clock,
+ * so the ADSP keeps LPASS powered and its AUDIO DRV holds CX up for the whole
+ * sleep. Drop it once the streams are suspended and take it back before they
+ * resume.
+ */
+static int sc8280xp_snd_suspend_post(struct snd_soc_card *card)
+{
+	struct sc8280xp_snd_data *pdata = snd_soc_card_get_drvdata(card);
+
+	snd_soc_dpcm_mutex_lock(card);
+	if (pdata->i2s_clk_count)
+		clk_disable_unprepare(pdata->i2s_clk);
+	pdata->i2s_clk_suspended = true;
+	snd_soc_dpcm_mutex_unlock(card);
+	return 0;
+}
+
+static int sc8280xp_snd_resume_pre(struct snd_soc_card *card)
+{
+	struct sc8280xp_snd_data *pdata = snd_soc_card_get_drvdata(card);
+	int ret = 0;
+
+	snd_soc_dpcm_mutex_lock(card);
+	pdata->i2s_clk_suspended = false;
+	if (pdata->i2s_clk_count)
+		ret = clk_prepare_enable(pdata->i2s_clk);
+	snd_soc_dpcm_mutex_unlock(card);
+	if (ret)
+		dev_err(card->dev, "failed to re-enable the I2S clock: %d\n", ret);
+	return 0;
+}
+
 static int sc8280xp_platform_probe(struct platform_device *pdev)
 {
 	struct snd_soc_card *card;
@@ -468,6 +505,8 @@ static int sc8280xp_platform_probe(struct platform_device *pdev)
 	if (IS_ERR(data->i2s_clk))
 		return dev_err_probe(dev, PTR_ERR(data->i2s_clk), "unable to get i2s clock\n");
 
+	card->suspend_post = sc8280xp_snd_suspend_post;
+	card->resume_pre = sc8280xp_snd_resume_pre;
 	card->driver_name = data->priv->driver_name;
 	sc8280xp_add_be_ops(card);
 	return devm_snd_soc_register_card(dev, card);
