lowerdeck: follow window size changes, ignore SDL mouse copies of touches

On the AYN Thor the bottom panel is rotated after lowerdeck maps, so the
size read at start-up went stale: the layout was drawn for portrait and
touches were scaled with the wrong size (taps missed their buttons).
Every tap was also handled twice, as a finger and as SDL's synthesized
mouse click.

--- a/sdl2.py
+++ b/sdl2.py
@@ -33,6 +33,9 @@
 PIXELFORMAT_ARGB8888      = 0x16362004
 
 EVENT_QUIT                = 0x100
+EVENT_WINDOWEVENT         = 0x200
+WINDOWEVENT_SIZE_CHANGED  = 6
+TOUCH_MOUSEID             = 0xFFFFFFFF
 EVENT_FINGERDOWN          = 0x700
 EVENT_FINGERUP            = 0x701
 EVENT_FINGERMOTION        = 0x702
--- a/main.py
+++ b/main.py
@@ -532,13 +532,33 @@
                 px = int(tf.x * self.size[0])
                 py = int(tf.y * self.size[1])
                 self._on_motion(px, py)
+            elif t == sdl.EVENT_WINDOWEVENT:
+                if ev.data[12] == sdl.WINDOWEVENT_SIZE_CHANGED:
+                    self._resized()
             elif t in (sdl.EVENT_MOUSEBUTTONDOWN, sdl.EVENT_MOUSEBUTTONUP):
                 mb = ctypes.cast(ctypes.pointer(ev), ctypes.POINTER(sdl.MouseButtonEvent)).contents
+                if mb.which == sdl.TOUCH_MOUSEID:
+                    continue  # SDL's mouse copy of a touch, already handled as a finger event
                 self._on_input(t == sdl.EVENT_MOUSEBUTTONDOWN, mb.x, mb.y)
             elif t == sdl.EVENT_MOUSEMOTION:
                 mm = ctypes.cast(ctypes.pointer(ev), ctypes.POINTER(sdl.MouseMotionEvent)).contents
+                if mm.which == sdl.TOUCH_MOUSEID:
+                    continue
                 self._on_motion(mm.x, mm.y)
 
+    def _resized(self) -> None:
+        """The window size changes after start-up when the compositor rotates or moves the panel (on the AYN Thor
+        the bottom panel is rotated after lowerdeck maps). Rebuild what was sized from it, or the layout is drawn
+        for the old size and touches land in the wrong place."""
+        w, h = ctypes.c_int(0), ctypes.c_int(0)
+        sdl.GetWindowSize(self.window, ctypes.byref(w), ctypes.byref(h))
+        if (w.value, h.value) == self.size:
+            return
+        self.size = (w.value, h.value)
+        self.layout = build_layout(*self.size)
+        self._load_fonts()
+        self.ach_view.configure(self.layout.achievements_rect, self.font_size_label, self.font_size_date)
+
