# Gyro, step 2: serve the ADSP sensors PD its files so the sensor core's QMI service (svc 400) comes up.
# The HexagonFS root holds Android's DSP libraries, sensor configs and this unit's own calibration, so it's not in
# the image: copy it to /storage/.config/asgard/sensors-root (see the README). Without it the unit doesn't start.
# Disable it if the ADSP (audio, charging) misbehaves.
[Unit]
Description=Thor ADSP sensors PD FastRPC server (hexagonrpcd)
ConditionPathExists=/storage/.config/asgard/sensors-root/hexagonrpc.json
# ponytail: stopped for sleep and not restarted after resume; whether the PD survives a sleep is untested.
Conflicts=suspend.target
Before=suspend.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
# The ADSP creates /dev/fastrpc-adsp a few seconds into boot, after multi-user units start.
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do [ -e /dev/fastrpc-adsp ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -s -R /storage/.config/asgard/sensors-root
Restart=on-failure
RestartSec=3
StandardOutput=append:/var/log/thor-sensorspd.log
StandardError=append:/var/log/thor-sensorspd.log

[Install]
WantedBy=multi-user.target
