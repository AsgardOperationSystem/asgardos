From: Asgard <asgard@localhost>
Subject: [PATCH] soc: qcom: expose the XBL boot log in debugfs

Read-only /sys/kernel/debug/xbl_log over reserved-memory xbl-dt-log-merged-region,
for reading the bootloader's reset reason after the floor-dropped s2idle reset.
---
diff --color -ruN a/drivers/soc/qcom/asgard-xbl-log.c b/drivers/soc/qcom/asgard-xbl-log.c
--- a/drivers/soc/qcom/asgard-xbl-log.c	1970-01-01 02:00:00.000000000 +0200
+++ b/drivers/soc/qcom/asgard-xbl-log.c	2026-10-14 22:56:09.208670675 +0300
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Asgard: expose the bootloader's log (reserved-memory xbl-dt-log-merged-region,
+ * no-map, so /dev/mem can't read it under STRICT_DEVMEM) read-only at
+ * /sys/kernel/debug/xbl_log. After an unexplained reset it holds XBL's view of
+ * the reset reason. ponytail: first matching node only, mapped for the whole uptime.
+ */
+#include <linux/debugfs.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/string.h>
+
+static struct debugfs_blob_wrapper xbl_log_blob;
+
+static int __init xbl_log_init(void)
+{
+	struct device_node *parent, *np;
+	struct resource res;
+	void *va = NULL;
+
+	parent = of_find_node_by_path("/reserved-memory");
+	if (!parent)
+		return 0;
+	for_each_child_of_node(parent, np) {
+		if (strncmp(np->name, "xbl-dt-log", 10) || of_address_to_resource(np, 0, &res))
+			continue;
+		va = memremap(res.start, resource_size(&res), MEMREMAP_WB);
+		of_node_put(np);
+		break;
+	}
+	of_node_put(parent);
+	if (!va)
+		return 0;
+
+	xbl_log_blob.data = va;
+	xbl_log_blob.size = resource_size(&res);
+	debugfs_create_blob("xbl_log", 0400, NULL, &xbl_log_blob);
+	pr_info("asgard-xbl-log: %pR at debugfs xbl_log\n", &res);
+	return 0;
+}
+late_initcall(xbl_log_init);
+MODULE_LICENSE("GPL");
diff --color -ruN a/drivers/soc/qcom/Makefile b/drivers/soc/qcom/Makefile
--- a/drivers/soc/qcom/Makefile	2026-10-14 22:56:09.204748391 +0300
+++ b/drivers/soc/qcom/Makefile	2026-10-14 22:56:09.207146628 +0300
@@ -21,6 +21,7 @@
 obj-$(CONFIG_QCOM_RPM_MASTER_STATS)	+= rpm_master_stats.o
 obj-$(CONFIG_QCOM_RPMH)		+= qcom_rpmh.o
 obj-$(CONFIG_QCOM_RPMH)		+= asgard-ddr-wake.o
+obj-$(CONFIG_QCOM_RPMH)		+= asgard-xbl-log.o
 qcom_rpmh-y			+= rpmh-rsc.o
 qcom_rpmh-y			+= rpmh.o
 obj-$(CONFIG_QCOM_SMD_RPM)	+= rpm-proc.o smd-rpm.o
