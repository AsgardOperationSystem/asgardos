+// Count every buffer commit against the toplevel it belongs to, subsurfaces included: Qt apps (Eden, Azahar)
+// draw the game into a subsurface. The toplevel lookup returns NULL once the role is gone, so no stale view.
+struct frame_counter {
+	struct wlr_surface *surface;
+	struct wl_listener commit;
+	struct wl_listener destroy;
+};
+
+static void frame_counter_commit(struct wl_listener *listener, void *data) {
+	struct frame_counter *fc = wl_container_of(listener, fc, commit);
+	if (!(fc->surface->current.committed & WLR_SURFACE_STATE_BUFFER)) {
+		return;
+	}
+	struct wlr_xdg_toplevel *toplevel = wlr_xdg_toplevel_try_from_wlr_surface(
+		wlr_surface_get_root_surface(fc->surface));
+	struct sway_view *view = toplevel ? toplevel->base->data : NULL;
+	if (view) {
+		view->frames++;
+	}
+}
+
+static void frame_counter_destroy(struct wl_listener *listener, void *data) {
+	struct frame_counter *fc = wl_container_of(listener, fc, destroy);
+	wl_list_remove(&fc->commit.link);
+	wl_list_remove(&fc->destroy.link);
+	free(fc);
+}
+
+static void handle_new_surface_frames(struct wl_listener *listener, void *data) {
+	struct wlr_surface *surface = data;
+	struct frame_counter *fc = calloc(1, sizeof(*fc));
+	if (!fc) {
+		return;
+	}
+	fc->surface = surface;
+	fc->commit.notify = frame_counter_commit;
+	wl_signal_add(&surface->events.commit, &fc->commit);
+	fc->destroy.notify = frame_counter_destroy;
+	wl_signal_add(&surface->events.destroy, &fc->destroy);
+}
+
+static struct wl_listener new_surface_frames = { .notify = handle_new_surface_frames };
+
