From: Asgard <asgard@localhost>
Subject: [PATCH] soc: qcom: aoss / PCI: qcom: runtime switches for the CXSD-only sleep experiment

qcom_aoss.aosd=0 sends "{class: aoss_slp, res: sleep, val: disable}" so AOP
stops system sleep at CXSD instead of AOSD (XO shutdown); justririll/x1e-sleep
uses the same message on X1E, whose resets happen only inside AOSD.
pcie_qcom.suspend_floor=0 drops the 0220/0221 DDR/LLCC suspend vote.
Both are writable at runtime. suspend_floor defaults to off since 2026-10-16:
with 9045 (link powered down) and 9047 (LPASS votes released) the SoC reaches
CXSD/AOSD/DDR LPM in s2idle, 99.9% of a 1 h sleep at ~23 mA (46 mA with the floor).
---
diff --color -ru a/drivers/pci/controller/dwc/pcie-qcom.c b/drivers/pci/controller/dwc/pcie-qcom.c
--- a/drivers/pci/controller/dwc/pcie-qcom.c	2026-10-14 19:32:08.456088973 +0300
+++ b/drivers/pci/controller/dwc/pcie-qcom.c	2026-10-14 19:32:25.745544106 +0300
@@ -2212,6 +2212,15 @@
  * the sleep-set bandwidth votes survive the platform sleep state.  Fall
  * back to dropping the OPP entirely when no suspend OPP is marked.
  */
+/*
+ * Asgard sleep experiment: pcie_qcom.suspend_floor=0 drops the opp-suspend
+ * DDR/LLCC floor (0220/0221) back to NULL at suspend. Off by default since
+ * 2026-10-16 (9045 + 9047: CXSD/AOSD reached, wakes fine); =1 puts it back.
+ */
+static bool suspend_floor;
+module_param(suspend_floor, bool, 0644);
+MODULE_PARM_DESC(suspend_floor, "keep the opp-suspend DDR/LLCC vote in s2idle");
+
 static int qcom_pcie_set_suspend_opp(struct qcom_pcie *pcie)
 {
 	struct device *dev = pcie->pci->dev;
@@ -2220,7 +2229,7 @@
 	int ret;
 
 	freq = dev_pm_opp_get_suspend_opp_freq(dev);
-	if (!freq)
+	if (!freq || !suspend_floor)
 		return dev_pm_opp_set_opp(dev, NULL);
 
 	opp = dev_pm_opp_find_freq_exact(dev, freq, true);
diff --color -ru a/drivers/soc/qcom/qcom_aoss.c b/drivers/soc/qcom/qcom_aoss.c
--- a/drivers/soc/qcom/qcom_aoss.c	2026-10-14 19:32:08.455231400 +0300
+++ b/drivers/soc/qcom/qcom_aoss.c	2026-10-14 19:32:25.745457302 +0300
@@ -556,6 +556,42 @@
 	.write = qmp_debugfs_write,
 };
 
+/*
+ * Asgard sleep experiment: qcom_aoss.aosd=0 asks AOP to stop system sleep at
+ * CXSD (CX collapse + DDR low power) and never enter AOSD (XO shutdown).
+ * x1e-sleep found X1E resets only inside AOSD; this checks whether SM8550's
+ * reset-on-wake without a DDR floor is the same. Writable at runtime:
+ * /sys/module/qcom_aoss/parameters/aosd. ponytail: one global AOSS instance.
+ */
+static struct qmp *qmp_aosd_inst;
+static bool qmp_aosd = true;
+
+static int qmp_aosd_send(void)
+{
+	if (!qmp_aosd_inst)
+		return 0;
+	return qmp_send(qmp_aosd_inst, "{class: aoss_slp, res: sleep, val: %s}",
+			qmp_aosd ? "enable" : "disable");
+}
+
+static int qmp_aosd_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_bool(val, kp);
+
+	if (ret)
+		return ret;
+	ret = qmp_aosd_send();
+	pr_info("qcom_aoss: AOSD %s (qmp_send %d)\n", qmp_aosd ? "allowed" : "blocked", ret);
+	return ret;
+}
+
+static const struct kernel_param_ops qmp_aosd_ops = {
+	.set = qmp_aosd_set,
+	.get = param_get_bool,
+};
+module_param_cb(aosd, &qmp_aosd_ops, &qmp_aosd, 0644);
+MODULE_PARM_DESC(aosd, "allow AOSD (XO shutdown) in system sleep; 0 = stop at CXSD");
+
 static void qmp_debugfs_create(struct qmp *qmp)
 {
 	const struct qmp_debugfs_entry *entry;
@@ -623,6 +659,10 @@
 
 	qmp_debugfs_create(qmp);
 
+	qmp_aosd_inst = qmp;
+	if (!qmp_aosd)
+		qmp_aosd_send();
+
 	return 0;
 
 err_close_qmp:
@@ -637,6 +677,7 @@
 {
 	struct qmp *qmp = platform_get_drvdata(pdev);
 
+	qmp_aosd_inst = NULL;
 	debugfs_remove_recursive(qmp->debugfs_root);
 
 	qmp_qdss_clk_remove(qmp);
