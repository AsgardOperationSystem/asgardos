From: Chaos Ruler <zmelumian@gmail.com>
Subject: [PATCH] drm/panel: ch13726a: Thor bottom panel timings from its Android DT

The Thor reused the RP Mini V2 mode (h porches 28/4/36, v 16/4/8). Its Android DT
(qcom,mdss_dsi_ch13726a_amoled_video) uses 12/4/12 both ways at 60 Hz; the bottom screen
flickered under continuously updating content (Azahar, gen1recomp companion). Also wait
120 ms after sleep-out, as the Android on-command and the DCS spec do (Kettle 0058).
---
--- a/drivers/gpu/drm/panel/panel-ddic-ch13726a.c	2026-10-16 12:44:19.556486531 +0300
+++ b/drivers/gpu/drm/panel/panel-ddic-ch13726a.c	2026-10-16 12:44:19.561870070 +0300
@@ -52,6 +52,8 @@
 	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xb9, 0x00);
 	
 	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	/* DCS: 120 ms after sleep-out before display-on (Android's on-command waits 0x78 ms too). */
+	mipi_dsi_msleep(&dsi_ctx, 120);
 
 	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
 
@@ -160,6 +162,25 @@
 	.height_mm = 75,
 };
 
+/*
+ * AYN Thor bottom panel: the timings of its Android DT (qcom,mdss_dsi_ch13726a_amoled_video:
+ * h/v front porch 12, pulse 4, back porch 12, 60 Hz; dyn-clk 1011/505 MHz). It borrowed the
+ * RP Mini V2 mode (h 28/4/36, v 16/4/8), and the whole bottom screen flickered under games.
+ */
+static const struct drm_display_mode thor_display_mode = {
+	.clock = (1080 + 12 + 4 + 12) * (1240 + 12 + 4 + 12) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 12,
+	.hsync_end = 1080 + 12 + 4,
+	.htotal = 1080 + 12 + 4 + 12,
+	.vdisplay = 1240,
+	.vsync_start = 1240 + 12,
+	.vsync_end = 1240 + 12 + 4,
+	.vtotal = 1240 + 12 + 4 + 12,
+	.width_mm = 65,
+	.height_mm = 75,
+};
+
 static int ch13726a_get_modes(struct drm_panel *panel,
 					struct drm_connector *connector)
 {
@@ -307,7 +328,7 @@
 	{ .compatible = "ch13726a,rp5", .data = &rp5_display_mode },
 	{ .compatible = "ch13726a,rpmini", .data = &rpmini_display_mode },
 	{ .compatible = "ch13726a,rpminiv2", .data = &rpminiv2_display_mode },
-	{ .compatible = "ch13726a,thor", .data = &rpminiv2_display_mode },
+	{ .compatible = "ch13726a,thor", .data = &thor_display_mode },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, ch13726a_of_match);
