From: Chaos Ruler <zmelumian@gmail.com>
Subject: [PATCH] drm/panel: chipone-icna35xx: Ultra Black switchable (ultra_black parameter)

9001 always sent AYN's enhance-color-command. Make it a writable module parameter, read at
every panel init: off sends Android's default-color-command (B7 byte 0x22, B8 byte 0x28, from
the live Android DT). Asgard Settings writes it and power-cycles the top screen.
---
--- a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
+++ b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
@@ -150,6 +150,14 @@
 	return dsi_ctx.accum_err;
 }
 
+/*
+ * AYN "OLED Ultra Black" on the ICNA3520, read at every panel init (Asgard Settings writes it, then power-cycles
+ * the screen). Off sends Android's default-color-command, on its enhance-color-command.
+ */
+static bool ultra_black = true;
+module_param(ultra_black, bool, 0644);
+MODULE_PARM_DESC(ultra_black, "ICNA3520 OLED Ultra Black (applied at the next panel power-on)");
+
 static int icna3520_init_sequence(struct panel_info *pinfo)
 {
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
@@ -211,14 +219,23 @@
 
 	/*
 	 * AYN "OLED Ultra Black" (enhance_color on): reduces colour shift and
-	 * mura at low brightness. Same DCS long writes Android sends at 60/120 Hz.
+	 * mura at low brightness. Same DCS long writes Android sends at 60/120 Hz;
+	 * off differs in two bytes (B7 0x22, B8 0x28).
 	 */
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9F, 0x00);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xB7, 0x00, 0x11, 0x11, 0x00, 0x55,
-				     0x55, 0x55, 0x55, 0x55, 0x55, 0x55, 0x55,
-				     0x55, 0x40, 0x40, 0x40, 0x15, 0x00);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xB8, 0x00, 0x00, 0x02, 0x41, 0x17,
-				     0x02, 0x28, 0x17, 0x00);
+	if (ultra_black) {
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xB7, 0x00, 0x11, 0x11, 0x00, 0x55,
+					     0x55, 0x55, 0x55, 0x55, 0x55, 0x55, 0x55,
+					     0x55, 0x40, 0x40, 0x40, 0x15, 0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xB8, 0x00, 0x00, 0x02, 0x41, 0x17,
+					     0x02, 0x28, 0x17, 0x00);
+	} else {
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xB7, 0x00, 0x11, 0x22, 0x00, 0x55,
+					     0x55, 0x55, 0x55, 0x55, 0x55, 0x55, 0x55,
+					     0x55, 0x40, 0x40, 0x40, 0x15, 0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xB8, 0x00, 0x00, 0x02, 0x28, 0x17,
+					     0x02, 0x28, 0x17, 0x00);
+	}
 
 	return dsi_ctx.accum_err;
 }
