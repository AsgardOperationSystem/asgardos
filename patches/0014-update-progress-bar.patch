From: Chaos Ruler <zmelumian@gmail.com>
Subject: [PATCH] Update install: progress bar under the logo instead of text

With rocknix-splash present, the installer's text goes to /dev/null and its
progress meters drive rocknix-splash --bar: percent while writing KERNEL and
SYSTEM, a moving segment for steps of unknown length (unpacking, md5).
---
--- a/projects/ROCKNIX/packages/sysutils/busybox/scripts/init
+++ b/projects/ROCKNIX/packages/sysutils/busybox/scripts/init
@@ -902,7 +902,15 @@
   mkdir -p ${UPDATE_DIR}/.tmp/avfs &>/dev/null
   sync
 
-  clear >/dev/console
+  # Asgard: the logo with a progress bar (SPLASH_BAR, see functions) instead of the installer's text.
+  if [ -x /usr/bin/rocknix-splash ]; then
+    export SPLASH_BAR=yes
+    exec >/dev/null 2>&1
+    /usr/bin/rocknix-splash
+    /usr/bin/rocknix-splash --bar -1 0
+  else
+    clear >/dev/console
+  fi
   echo "UPDATE IN PROGRESS"
   echo ""
   echo "Please do not reboot or turn off your device!"
--- a/projects/ROCKNIX/packages/sysutils/busybox/scripts/functions
+++ b/projects/ROCKNIX/packages/sysutils/busybox/scripts/functions
@@ -103,6 +103,7 @@
 
   while [ ! -f /dev/.progress/stop ]; do
     echo -en "\b${spinner:$count:1}"
+    [ "${SPLASH_BAR}" = "yes" ] && /usr/bin/rocknix-splash --bar -1 $count
     usleep 500000
     count=$(((count + 1) % 8))
   done
@@ -124,6 +125,7 @@
   while [ ! -f /dev/.progress/stop ]; do
     [ -f ${filename} ] && csize=$(stat -t "${filename}" | awk '{print $2}') || csize=0
     echo $csize $fsize | awk '{ printf "\b\b\b\b%3d%%", ($1 * 100 / $2) }'
+    [ "${SPLASH_BAR}" = "yes" ] && /usr/bin/rocknix-splash --bar $(echo $csize $fsize | awk '{ printf "%d", ($1 * 100 / $2) }')
     usleep 250000
   done
 
