+      wifi_wait_down
     fi
 
     headphones stop
@@ -119,8 +140,14 @@ case $1 in
     bluetooth start
 
     if [ "$(get_setting wifi.enabled)" == "1" ]; then
-      log $0 "Enabling WIFI."
-      nohup wifictl enable >${EVENTLOG} 2>&1
