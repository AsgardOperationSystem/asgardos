--- a/projects/ROCKNIX/devices/SM8550/linux/dts/qcom/qcs8550-ayn-thor.dts
+++ b/projects/ROCKNIX/devices/SM8550/linux/dts/qcom/qcs8550-ayn-thor.dts
@@ -517,3 +517,22 @@
 	};
 };
 
+
+/*
+ * Asgard 0030: 4 MB ramoops (pstore console + oops) at the end of the
+ * 0xbab00000-0xd7ffffff System RAM block, to see how far the floor-dropped
+ * s2idle resume gets before the SoC resets.
+ */
+/ {
+	reserved-memory {
+		ramoops@d7c00000 {
+			compatible = "ramoops";
+			reg = <0x0 0xd7c00000 0x0 0x400000>;
+			console-size = <0x200000>;
+			record-size = <0x40000>;
+			pmsg-size = <0x0>;
+			ecc-size = <0x0>;
+			no-map;
+		};
+	};
+};
