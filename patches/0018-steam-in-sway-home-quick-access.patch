From: Chaos Ruler <zmelumian@gmail.com>
Subject: [PATCH] Steam inside sway; Home opens Quick Access while it runs

By default (asgard.steam_nested, 0 = ROCKNIX's way) gamescope runs as a
fullscreen sway window on the top panel instead of taking the display over,
so the bottom panel stays sway's: the Thor Panel (AYN button) and Asgard's
overlays work in Steam. steam-pad-profile.py maps Home to Quick Access in
InputPlumber while Steam runs and puts the profile back after.
---
--- a/projects/ROCKNIX/packages/emulators/standalone/steam/scripts/start_steam.sh
+++ b/projects/ROCKNIX/packages/emulators/standalone/steam/scripts/start_steam.sh
@@ -218,9 +218,19 @@
   touch "$gamescope_mode_file"
   unset MESA_LOADER_DRIVER_OVERRIDE
 
-  # drm gamescope backend needs wayland socket unset and compositor stopped
-  unset WAYLAND_DISPLAY
-  systemctl stop sway
+  # Asgard: Steam inside sway by default (asgard.steam_nested): gamescope as a fullscreen sway window on the top
+  # panel, so the bottom panel stays sway's (Thor Panel, overlays). 0: ROCKNIX's way, gamescope owning the display.
+  local backend_flags="--backend drm --force-orientation ${force_orientation} ${rotate_flags}"
+  if [ "$(get_setting asgard.steam_nested)" != "0" ] && [ -n "${WAYLAND_DISPLAY}" ]; then
+    backend_flags="--backend wayland -f"
+    PREFER_OUTPUT=""
+    case "${TRANSFORM}" in 90|270) local t=${W}; W=${H}; H=${t} ;; esac   # the panel's landscape size
+  else
+    # drm gamescope backend needs wayland socket unset and compositor stopped
+    unset WAYLAND_DISPLAY
+    systemctl stop sway
+  fi
+  python3 /usr/share/asgard/steam-pad-profile.py on   # Home opens Quick Access while Steam runs
 
   if [ "${STEAM_FLAVOR}" = "arm64" ]; then
     export STEAM_COMPAT_GRAPHICS_PROVIDER=/storage/.local/share/fex-emu/RootFS/ArchLinux/graphics_provider.json
@@ -231,7 +241,7 @@
       rm -f "${steam_exit_code_file}"
       GAMESCOPE_MODE_SAVE_FILE="${gamescope_mode_file}" GAMESCOPE_FAKE_OUTPUT_MM=508x286 \
       LD_LIBRARY_PATH=/storage/.local/share/Steam/lib/aarch64-linux-gnu/ ${EMUPERF} \
-      gamescope $PREFER_OUTPUT -W "$W" -H "$H" -r "$REFRESH_HZ" --xwayland-count 2 --mangoapp --backend drm --force-orientation "${force_orientation}" ${rotate_flags} -e -- \
+      gamescope $PREFER_OUTPUT -W "$W" -H "$H" -r "$REFRESH_HZ" --xwayland-count 2 --mangoapp ${backend_flags} -e -- \
       /bin/bash -c '
         exit_file="$1"
         shift
@@ -250,6 +260,7 @@
     rm -f "${steam_exit_code_file}"
     steam_touch_calibration_end
     trap - EXIT
+    python3 /usr/share/asgard/steam-pad-profile.py off
     systemctl start essway
     exit 0
   else
@@ -257,10 +268,11 @@
     steam_touch_calibration_begin "${force_orientation}"
     trap steam_touch_calibration_end EXIT
     GAMESCOPE_MODE_SAVE_FILE="${gamescope_mode_file}" GAMESCOPE_FAKE_OUTPUT_MM=508x286 ${EMUPERF} \
-      gamescope $PREFER_OUTPUT -W "$W" -H "$H" -r "$REFRESH_HZ" --xwayland-count 2 --backend drm --force-orientation "${force_orientation}" ${rotate_flags} -- \
+      gamescope $PREFER_OUTPUT -W "$W" -H "$H" -r "$REFRESH_HZ" --xwayland-count 2 ${backend_flags} -- \
       FEX /usr/bin/steam -nobigpicture -noverifyfiles -nobootstrapupdate -skipinitialbootstrap -norepairfiles -noshaders ${game_uri:+"$game_uri"}
     steam_touch_calibration_end
     trap - EXIT
+    python3 /usr/share/asgard/steam-pad-profile.py off
     systemctl start essway
     exit 0
   fi
