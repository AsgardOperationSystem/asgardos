--- a/projects/ROCKNIX/packages/hardware/quirks/platforms/SM8550/bin/power-handler
+++ b/projects/ROCKNIX/packages/hardware/quirks/platforms/SM8550/bin/power-handler
@@ -32,6 +32,12 @@
 
 BLANK_FLAG="/run/power-blank-active.flag"
 
+# Asgard: a game set to keep running with the screens off (emulator option Sleep, asgard-perf-profile.sh) owns the
+# power key and the lid while it runs: asgard-screens-off.sh turns the screens off/on instead of suspending.
+if [ -e /run/asgard-keep-running ]; then
+  exec /usr/share/asgard/asgard-screens-off.sh "$@"
+fi
+
 # Devices where deep suspend is not validated keep the old behaviour exactly:
 # 030-suspend_mode leaves system.suspendmode off for them, and fake suspend is
 # still the right owner. Delegating rather than reimplementing keeps those
