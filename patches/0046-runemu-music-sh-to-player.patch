+# If the rom is a shell script just execute it, useful for DOSBOX and ScummVM scan scripts. Not the music system:
+# its "Start Music Player.sh" (a start_gmu.sh symlink) goes to the chosen player, Asgard Music by default.
+if [[ "${ROMNAME}" == *".sh" ]] && [ ! "${PLATFORM}" = "ports" ] && [ ! "${PLATFORM}" = "windows" ] && [ ! "${PLATFORM}" = "music" ]; then
         ${VERBOSE} && log $0 "Executing shell script ${ROMNAME}"
         ${GAMESCOPE_CMD} "${ROMNAME}" &>>${OUTPUT_LOG}
         ret_error=$?
