From: Asgard <asgard@localhost>
Subject: [PATCH] soc: qcom: read-only debugfs dump of the display RSC TCSs

Shows the votes the bootloader left in disp_rsc, which mainline never drives.
---
diff --color -ruN a/drivers/soc/qcom/asgard-disp-rsc-dump.c b/drivers/soc/qcom/asgard-disp-rsc-dump.c
--- a/drivers/soc/qcom/asgard-disp-rsc-dump.c	1970-01-01 02:00:00.000000000 +0200
+++ b/drivers/soc/qcom/asgard-disp-rsc-dump.c	2026-10-14 23:19:37.575056243 +0300
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Asgard: read-only dump of the display RSC (disp_rsc @ 0xaf20000, DRV 0, TCS
+ * base 0x1c00; Android DT: TCS 0 = SLEEP, TCS 1 = WAKE). Mainline never drives
+ * this RSC, so its TCSs hold whatever the bootloader's display code left; those
+ * are the display DRV's standing RPMh votes. Reading needs the RSCC AHB clock,
+ * which nothing in Linux keeps on: like Android's qcom,sde-rsc it holds the MDSS
+ * runtime PM (mdss_gdsc) and enables NON_GDSC_AHB, RSCC_AHB, RSCC_VSYNC for the read. cat /sys/kernel/debug/disp_rsc_dump
+ */
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/debugfs.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/seq_file.h>
+
+#define DISP_RSC_BASE		0x0af20000
+#define DISP_RSC_SIZE		0x10000
+#define DISP_RSC_TCS_BASE	0x1c00
+#define TCS_STRIDE		672	/* RSC v3 RSC_DRV_TCS_OFFSET */
+#define CMD_STRIDE		24	/* RSC v3 RSC_DRV_CMD_OFFSET */
+/* what Android's qcom,sde-rsc node turns on first: these three + vdd = mdss_gdsc */
+static const u32 rscc_clks[] = { 65 /* NON_GDSC_AHB */, 70 /* RSCC_AHB */, 71 /* RSCC_VSYNC */ };
+
+static int disp_rsc_dump_show(struct seq_file *s, void *unused)
+{
+	struct clk *clks[ARRAY_SIZE(rscc_clks)] = {};
+	struct platform_device *mdss = NULL;
+	struct device_node *np;
+	void __iomem *base;
+	int i, t, c, ret = 0;
+
+	/* hold mdss_gdsc on through the display subsystem's runtime PM */
+	np = of_find_compatible_node(NULL, NULL, "qcom,sm8550-mdss");
+	if (np)
+		mdss = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!mdss)
+		return -ENODEV;
+	ret = pm_runtime_resume_and_get(&mdss->dev);
+	if (ret)
+		goto put_mdss;
+
+	np = of_find_compatible_node(NULL, NULL, "qcom,sm8550-dispcc");
+	for (i = 0; np && i < ARRAY_SIZE(rscc_clks); i++) {
+		struct of_phandle_args args = { .np = np, .args_count = 1, .args = { rscc_clks[i] } };
+
+		clks[i] = of_clk_get_from_provider(&args);
+		ret = IS_ERR(clks[i]) ? PTR_ERR(clks[i]) : clk_prepare_enable(clks[i]);
+		if (ret) {
+			if (!IS_ERR(clks[i]))
+				clk_put(clks[i]);
+			clks[i] = NULL;
+			break;
+		}
+	}
+	of_node_put(np);
+	if (ret || !np)
+		goto off;
+
+	base = ioremap(DISP_RSC_BASE, DISP_RSC_SIZE);
+	if (!base) {
+		ret = -ENOMEM;
+		goto off;
+	}
+	seq_puts(s, "drv regs 0x00-0x3c:");
+	for (c = 0; c < 0x40; c += 4)
+		seq_printf(s, " %08x", readl(base + c));
+	seq_putc(s, '\n');
+	for (t = 0; t < 2; t++) {
+		void __iomem *tb = base + DISP_RSC_TCS_BASE + TCS_STRIDE * t;
+		u32 en = readl(tb + 0x2c);
+
+		seq_printf(s, "tcs%d (%s) ctrl %08x status %08x cmd_enable %08x\n", t,
+			   t ? "wake" : "sleep", readl(tb + 0x24), readl(tb + 0x28), en);
+		for (c = 0; c < 16; c++)
+			if (en & BIT(c))
+				seq_printf(s, "  cmd%-2d msgid %08x addr %08x data %08x status %08x\n", c,
+					   readl(tb + 0x34 + CMD_STRIDE * c), readl(tb + 0x38 + CMD_STRIDE * c),
+					   readl(tb + 0x3c + CMD_STRIDE * c), readl(tb + 0x40 + CMD_STRIDE * c));
+	}
+	iounmap(base);
+off:
+	for (i = ARRAY_SIZE(rscc_clks) - 1; i >= 0; i--)
+		if (clks[i]) {
+			clk_disable_unprepare(clks[i]);
+			clk_put(clks[i]);
+		}
+	pm_runtime_put(&mdss->dev);
+put_mdss:
+	put_device(&mdss->dev);
+	return ret;
+}
+DEFINE_SHOW_ATTRIBUTE(disp_rsc_dump);
+
+static int __init disp_rsc_dump_init(void)
+{
+	if (of_machine_is_compatible("ayn,thor"))
+		debugfs_create_file("disp_rsc_dump", 0400, NULL, NULL, &disp_rsc_dump_fops);
+	return 0;
+}
+late_initcall(disp_rsc_dump_init);
+MODULE_LICENSE("GPL");
diff --color -ruN a/drivers/soc/qcom/Makefile b/drivers/soc/qcom/Makefile
--- a/drivers/soc/qcom/Makefile	2026-10-14 23:10:27.994616371 +0300
+++ b/drivers/soc/qcom/Makefile	2026-10-14 23:10:27.995690206 +0300
@@ -22,6 +22,7 @@
 obj-$(CONFIG_QCOM_RPMH)		+= qcom_rpmh.o
 obj-$(CONFIG_QCOM_RPMH)		+= asgard-ddr-wake.o
 obj-$(CONFIG_QCOM_RPMH)		+= asgard-xbl-log.o
+obj-$(CONFIG_QCOM_RPMH)		+= asgard-disp-rsc-dump.o
 qcom_rpmh-y			+= rpmh-rsc.o
 qcom_rpmh-y			+= rpmh.o
 obj-$(CONFIG_QCOM_SMD_RPM)	+= rpm-proc.o smd-rpm.o
