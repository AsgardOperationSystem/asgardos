 };
 
+
+/*
+ * Asgard 0028: Android's apps_rsc sleep/wake sets (RPMh trace, 2026-10-14) switch
+ * LDO E1 (0x43900) and E3 (0x43a00) off in SLEEP and back on in WAKE, around every
+ * CX/DDR collapse. With 0218/0219 this makes Linux write the same pair.
+ */
+&vreg_l1e_0p88 {
+	regulator-state-mem {
+		regulator-off-in-suspend;
+	};
+};
+
+&vreg_l3e_1p2 {
+	regulator-state-mem {
+		regulator-off-in-suspend;
+	};
+};
