From: ROCKNIX local test <noreply@localhost>
Subject: [PATCH] soc: qcom: add smp2p sleepstate notifier

Port of the downstream Qualcomm smp2p_sleepstate driver (msm-5.15, see
OnePlusOSS/android_kernel_oneplus_sm8550). Local experiment, not upstream.
---
diff '--color=never' -Nru a/drivers/soc/qcom/Kconfig b/drivers/soc/qcom/Kconfig
--- a/drivers/soc/qcom/Kconfig	2026-10-07 00:31:39.230125181 +0300
+++ b/drivers/soc/qcom/Kconfig	2026-10-07 00:31:39.282930548 +0300
@@ -209,6 +209,15 @@
 	  Say yes here to support the Qualcomm Shared Memory Point to Point
 	  protocol.
 
+config QCOM_SMP2P_SLEEPSTATE
+	tristate "Qualcomm SMP2P sleep state notifier"
+	depends on QCOM_SMP2P
+	depends on PM_SLEEP
+	help
+	  Signals the application processor's awake state to a remote
+	  processor over SMP2P, so it can defer non-urgent notifications
+	  while the system is suspended.
+
 config QCOM_SMSM
 	tristate "Qualcomm Shared Memory State Machine"
 	depends on MAILBOX
diff '--color=never' -Nru a/drivers/soc/qcom/Makefile b/drivers/soc/qcom/Makefile
--- a/drivers/soc/qcom/Makefile	2026-10-07 00:31:39.229125155 +0300
+++ b/drivers/soc/qcom/Makefile	2026-10-07 00:31:39.237521907 +0300
@@ -27,6 +27,7 @@
 obj-$(CONFIG_QCOM_SMEM_STATE) += smem_state.o
 CFLAGS_smp2p.o := -I$(src)
 obj-$(CONFIG_QCOM_SMP2P)	+= smp2p.o
+obj-$(CONFIG_QCOM_SMP2P_SLEEPSTATE)	+= smp2p_sleepstate.o
 obj-$(CONFIG_QCOM_SMSM)	+= smsm.o
 obj-$(CONFIG_QCOM_SOCINFO)	+= socinfo.o
 obj-$(CONFIG_QCOM_SPM)		+= spm.o
diff '--color=never' -Nru a/drivers/soc/qcom/smp2p_sleepstate.c b/drivers/soc/qcom/smp2p_sleepstate.c
--- a/drivers/soc/qcom/smp2p_sleepstate.c	1970-01-01 02:00:00.000000000 +0200
+++ b/drivers/soc/qcom/smp2p_sleepstate.c	2026-10-07 00:31:39.231125207 +0300
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2014-2021, The Linux Foundation. All rights reserved.
+ *
+ * Ported from the Qualcomm downstream kernel (msm-5.15, as published in
+ * OnePlusOSS/android_kernel_oneplus_sm8550 drivers/soc/qcom/smp2p_sleepstate.c).
+ * Tells the remote processor over SMP2P whether the application processor
+ * is awake, so it can hold back non-urgent notifications while the AP is
+ * suspended.
+ */
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/pm_wakeup.h>
+#include <linux/soc/qcom/smem_state.h>
+#include <linux/suspend.h>
+
+#define AWAKE_BIT BIT(12)
+
+struct smp2p_sleepstate {
+	struct qcom_smem_state *state;
+	struct notifier_block nb;
+	struct wakeup_source *ws;
+};
+
+static int smp2p_sleepstate_pm_notifier(struct notifier_block *nb,
+					unsigned long event, void *unused)
+{
+	struct smp2p_sleepstate *ss = container_of(nb, struct smp2p_sleepstate, nb);
+
+	switch (event) {
+	case PM_SUSPEND_PREPARE:
+		qcom_smem_state_update_bits(ss->state, AWAKE_BIT, 0);
+		break;
+	case PM_POST_SUSPEND:
+		qcom_smem_state_update_bits(ss->state, AWAKE_BIT, AWAKE_BIT);
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static irqreturn_t smp2p_sleepstate_handler(int irq, void *data)
+{
+	struct smp2p_sleepstate *ss = data;
+
+	__pm_wakeup_event(ss->ws, 200);
+
+	return IRQ_HANDLED;
+}
+
+static void smp2p_sleepstate_ws_release(void *ws)
+{
+	wakeup_source_unregister(ws);
+}
+
+static int smp2p_sleepstate_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct smp2p_sleepstate *ss;
+	unsigned int bit;
+	int irq, ret;
+
+	ss = devm_kzalloc(dev, sizeof(*ss), GFP_KERNEL);
+	if (!ss)
+		return -ENOMEM;
+
+	ss->state = devm_qcom_smem_state_get(dev, NULL, &bit);
+	if (IS_ERR(ss->state))
+		return PTR_ERR(ss->state);
+
+	irq = of_irq_get_byname(dev->of_node, "smp2p-sleepstate-in");
+	if (irq <= 0)
+		return dev_err_probe(dev, irq ? irq : -ENXIO, "no smp2p-sleepstate-in irq\n");
+
+	ss->ws = wakeup_source_register(dev, "smp2p-sleepstate");
+	if (!ss->ws)
+		return -ENOMEM;
+	ret = devm_add_action_or_reset(dev, smp2p_sleepstate_ws_release, ss->ws);
+	if (ret)
+		return ret;
+
+	ret = devm_request_threaded_irq(dev, irq, NULL, smp2p_sleepstate_handler,
+					IRQF_ONESHOT | IRQF_TRIGGER_RISING,
+					"smp2p_sleepstate", ss);
+	if (ret)
+		return ret;
+
+	qcom_smem_state_update_bits(ss->state, AWAKE_BIT, AWAKE_BIT);
+
+	ss->nb.notifier_call = smp2p_sleepstate_pm_notifier;
+	ss->nb.priority = INT_MAX;
+	ret = register_pm_notifier(&ss->nb);
+	if (ret)
+		return ret;
+
+	platform_set_drvdata(pdev, ss);
+
+	return 0;
+}
+
+static void smp2p_sleepstate_remove(struct platform_device *pdev)
+{
+	struct smp2p_sleepstate *ss = platform_get_drvdata(pdev);
+
+	unregister_pm_notifier(&ss->nb);
+}
+
+static const struct of_device_id smp2p_sleepstate_match[] = {
+	{ .compatible = "qcom,smp2p-sleepstate" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, smp2p_sleepstate_match);
+
+static struct platform_driver smp2p_sleepstate_driver = {
+	.probe = smp2p_sleepstate_probe,
+	.remove = smp2p_sleepstate_remove,
+	.driver = {
+		.name = "smp2p_sleepstate",
+		.of_match_table = smp2p_sleepstate_match,
+	},
+};
+module_platform_driver(smp2p_sleepstate_driver);
+
+MODULE_DESCRIPTION("Qualcomm SMP2P sleep state notifier");
+MODULE_LICENSE("GPL");
