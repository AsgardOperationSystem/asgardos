From: Chaos Ruler <zmelumian@gmail.com>
Subject: [PATCH] power: supply: qcom_battmgr: AYN Thor charge limit via vendor property

AYN Thor ADSP firmware ignores BATTMGR_CHG_CTRL_LIMIT_EN (0x48). AYN Android
(qti_battery_charger limit_capacity_charge) writes property 16 via
BATTMGR_BAT_PROPERTY_SET instead: 1 = limit to 80 %, 0 = off. Map
charge_control_end_threshold <= 80 to that on ayn,thor. Local, not upstream.
---
--- a/drivers/power/supply/qcom_battmgr.c	2026-10-07 22:35:06.636262486 +0300
+++ b/drivers/power/supply/qcom_battmgr.c	2026-10-07 22:35:06.643232485 +0300
@@ -6,6 +6,7 @@
  */
 #include <linux/auxiliary_bus.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/mutex.h>
 #include <linux/nvmem-consumer.h>
 #include <linux/of_device.h>
@@ -713,6 +714,26 @@
 
 	end_soc = clamp(end_soc, CHARGE_CTRL_END_THR_MIN, CHARGE_CTRL_END_THR_MAX);
 
+	/*
+	 * AYN Thor ADSP firmware ignores BATTMGR_CHG_CTRL_LIMIT_EN. AYN's Android
+	 * driver (qti_battery_charger: limit_capacity_charge) instead writes
+	 * property 16 with BATTMGR_BAT_PROPERTY_SET: 1 = stop at 80 %, 0 = off.
+	 * The firmware owns the 80 % / restart levels, so map any end <= 80 to on.
+	 */
+	if (of_machine_is_compatible("ayn,thor")) {
+		u32 on = end_soc <= 80;
+
+		mutex_lock(&battmgr->lock);
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_SET,
+						    BATT_CHG_FULL_DESIGN, on);
+		mutex_unlock(&battmgr->lock);
+		if (!ret) {
+			battmgr->info.charge_ctrl_end = on ? 80 : 100;
+			battmgr->info.charge_ctrl_start = on ? 80 - CHARGE_CTRL_DELTA_SOC : 0;
+		}
+		return 0;
+	}
+
 	if (battmgr->info.charge_ctrl_start && end_soc > battmgr->info.charge_ctrl_start)
 		delta_soc = end_soc - battmgr->info.charge_ctrl_start;
 
@@ -1379,6 +1400,9 @@
 	}
 
 	switch (opcode) {
+	case BATTMGR_BAT_PROPERTY_SET:
+		battmgr->error = 0;
+		break;
 	case BATTMGR_BAT_PROPERTY_GET:
 		property = le32_to_cpu(resp->intval.property);
 		if (property == BATT_MODEL_NAME) {
