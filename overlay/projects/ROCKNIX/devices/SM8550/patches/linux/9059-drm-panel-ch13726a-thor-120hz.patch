From: Chaos Ruler <zmelumian@gmail.com>
Subject: [PATCH] drm/panel: ch13726a: Thor bottom panel 120 Hz mode

AYN's Android DT lists dfps 120/60 for the bottom panel (qcom,dsi-supported-dfps-list),
and its dyn-clk 1011/505 Mbps are the lane rates of the 12/4/12 timings at 120 and 60 Hz.
Offer the 120 Hz mode next to the preferred 60 Hz one; Asgard picks it from Settings.
---
--- a/drivers/gpu/drm/panel/panel-ddic-ch13726a.c
+++ b/drivers/gpu/drm/panel/panel-ddic-ch13726a.c
@@ -181,6 +181,25 @@
 	.height_mm = 75,
 };
 
+/*
+ * The same timings at 120 Hz: Android lists dfps 120/60 for this panel, and its 1011 Mbps
+ * dyn-clk is exactly this mode's lane rate (505 Mbps is the 60 Hz one). Video mode, so the
+ * panel needs no command to switch. Offered as a second mode; 60 Hz stays preferred.
+ */
+static const struct drm_display_mode thor_display_mode_120 = {
+	.clock = (1080 + 12 + 4 + 12) * (1240 + 12 + 4 + 12) * 120 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 12,
+	.hsync_end = 1080 + 12 + 4,
+	.htotal = 1080 + 12 + 4 + 12,
+	.vdisplay = 1240,
+	.vsync_start = 1240 + 12,
+	.vsync_end = 1240 + 12 + 4,
+	.vtotal = 1240 + 12 + 4 + 12,
+	.width_mm = 65,
+	.height_mm = 75,
+};
+
 static int ch13726a_get_modes(struct drm_panel *panel,
 					struct drm_connector *connector)
 {
@@ -198,7 +217,17 @@
 	connector->display_info.height_mm = mode->height_mm;
 	drm_mode_probed_add(connector, mode);
 
-	return 1;
+	if (ctx->display_mode != &thor_display_mode)
+		return 1;
+
+	mode = drm_mode_duplicate(connector->dev, &thor_display_mode_120);
+	if (!mode)
+		return -ENOMEM;
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER;
+	drm_mode_probed_add(connector, mode);
+
+	return 2;
 }
 
 static enum drm_panel_orientation ch13726a_get_orientation(struct drm_panel *panel)
