#!/bin/bash
# Asgard boot tuning for the AYN Thor. Knobs are system.cfg keys, so asgard.yml can set them too.
. /etc/profile.d/001-functions

# /etc/hostname is read-only (says ROCKNIX); apply system.hostname.
H=$(get_setting system.hostname)
[ -n "$H" ] && hostname "$H"

# USB autosuspend so DWC3 + PHY can idle (udev covers a600000.usb only).
for u in /sys/bus/platform/devices/*.usb/power/control; do echo auto > "$u" 2>/dev/null; done

# Airplane mode (Thor Panel): every radio stays off across reboots until it's turned off there.
[ "$(get_setting asgard.airplane)" = "1" ] && rfkill block all

# Steam: ROCKNIX's Steam system lists .desktop files, and Steam.desktop opens Steam itself (Big Picture). Steam
# writes it only after it has run, so on a fresh install there was no Steam tile to start it from.
if [ -x /usr/bin/start_steam.sh ] && [ ! -e /storage/.local/share/applications/Steam.desktop ]; then
  mkdir -p /storage/.local/share/applications
  printf '[Desktop Entry]\nType=Application\nName=Steam\nExec=steam\n' > /storage/.local/share/applications/Steam.desktop
fi

# A fixed fan speed (asgard.fan_manual) is applied by fancontrol.service itself (asgard-fan.sh).

# CPU clock cap per core type (Settings > Performance), percent of each cluster's top clock.
/usr/share/asgard/asgard-cpu-cap.sh
# Gyro in the menu (Settings > Performance > Gyro, asgard.motion); games set their own (asgard-perf-profile.sh).
/usr/share/asgard/asgard-perf-profile.sh motion
