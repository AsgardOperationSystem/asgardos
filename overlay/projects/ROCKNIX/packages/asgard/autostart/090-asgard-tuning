#!/bin/bash
# Asgard boot tuning for the AYN Thor. Knobs are system.cfg keys, so asgard.yml can set them too.
. /etc/profile.d/001-functions

# /etc/hostname is read-only (says ROCKNIX); apply system.hostname.
H=$(get_setting system.hostname)
[ -n "$H" ] && hostname "$H"

# USB autosuspend so DWC3 + PHY can idle (udev covers a600000.usb only).
for u in /sys/bus/platform/devices/*.usb/power/control; do echo auto > "$u" 2>/dev/null; done

# Battery charge limit in % (kernel patch 9003, AYN firmware property). asgard.charge_limit=100 turns it off.
L=$(get_setting asgard.charge_limit)
echo "${L:-80}" > /sys/class/power_supply/battery/charge_control_end_threshold 2>/dev/null

# CPU clock cap for battery + a cooler shell, ~75 % of each cluster's top. asgard.cpu_cap=0 turns it off.
# policy0 = little (2016000 max), policy3 = mid (2803200), policy7 = big (2956800); measured 2026-10-09.
if [ "$(get_setting asgard.cpu_cap)" != "0" ]; then
  CAP_KHZ=(1785600 2054400 2227200)
  i=0
  for p in 0 3 7; do
    echo "${CAP_KHZ[$i]}" > /sys/devices/system/cpu/cpufreq/policy$p/scaling_max_freq 2>/dev/null
    i=$((i + 1))
  done
fi
