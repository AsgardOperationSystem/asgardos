#!/bin/sh

# Source system-wide profile
. /etc/profile

# Global variables
STORAGE_PATH="/storage"
CACHE_PATH="${STORAGE_PATH}/.cache"
BACKUP_DIR="${STORAGE_PATH}/roms/backups"
BACKUP_FILE="${BACKUP_DIR}/bluetooth.tar"
BT_DEVICE_FILE="/run/bt_device"
BT_LISTING_FILE="/run/bt_listing"
BT_LISTING_PID_FILE="/run/bt_listing.pid"
BT_CONTROL_FILE="/run/bt_discovery_control"
BT_AGENT_STATUS_FILE="/run/bt_agent_status"
BT_STATUS_FILE="/run/bt_status"
POWER_SUPPLY_PATH="/sys/class/power_supply"

# Action from command line
ACTION=$1

# Logging functions
log_error() {
    echo "ERROR: $1" >&2
}

log_info() {
    echo "INFO: $1"
}

# Helper function to check MAC address format
validate_mac_address() {
    echo "$1" | grep -qE "^([0-9A-F]{2}:){5}[0-9A-F]{2}$"
    return $?
}

# Display help information
do_help() {
    cat >&2 <<EOF
Usage: ${1} <command> [options]

Commands:
    list                        - List trusted bluetooth devices
    trust <device address>      - Trust a specific device
    trust input                 - Enter trust input mode
    remove <device address>     - Remove a device
    save                        - Backup bluetooth configuration
    restore                     - Restore bluetooth configuration
    start_live_devices          - Start monitoring devices
    stop_live_devices           - Stop monitoring devices
    scan_start                  - Start looking for devices, without waiting
    scan_list                   - Print the named devices found so far
    scan_stop                   - Stop looking for devices
    enable                      - Enable bluetooth
    disable                     - Disable bluetooth
    connect <device address>    - Connect to a device
    disconnect <device address> - Disconnect from a device
    codec <device address> <codec> - Play music to a connected device over a codec list offers (codecs=)
EOF
}

# Check if bluetooth agent is running
check_agent_status() {
    if [ ! -f "${BT_AGENT_STATUS_FILE}" ]; then
        return 1
    fi

    local pid
    pid=$(cat "${BT_AGENT_STATUS_FILE}")
    if ! kill -0 "${pid}" 2>/dev/null; then
        return 1
    fi

    return 0
}

# Backup bluetooth configuration
do_save() {
    mkdir -p "${BACKUP_DIR}"
    if (cd "${CACHE_PATH}" && tar cf "${BACKUP_FILE}" bluetooth); then
        log_info "Bluetooth configuration backed up to ${BACKUP_FILE}"
        return 0
    else
        log_error "Failed to backup bluetooth configuration"
        return 1
    fi
}

# Restore bluetooth configuration
do_restore() {
    if [ ! -f "${BACKUP_FILE}" ]; then
        log_error "Backup file ${BACKUP_FILE} not found"
        return 1
    fi

    if (cd "${CACHE_PATH}" && tar xf "${BACKUP_FILE}"); then
        log_info "Bluetooth configuration restored from ${BACKUP_FILE}"
        return 0
    else
        log_error "Failed to restore bluetooth configuration"
        return 1
    fi
}

# The audio codec PipeWire streams to a device over, from the api.bluez5.* properties of its sink in
# pactl's listing ($1): the address and the codec's PipeWire name, shown the way the codec is known
bt_codec() {
    echo "${SINKS}" | awk -v addr="$1" '
        /^Sink #/ { a = ""; c = "" }
        /api\.bluez5\.address = / { split($0, q, "\""); a = toupper(q[2]) }
        /api\.bluez5\.codec = / { split($0, q, "\""); c = q[2] }
        a == toupper(addr) && c != "" { print c; exit }' | {
        read -r CODEC
        case "${CODEC}" in
            "") ;;
            sbc_xq) echo "SBC-XQ" ;;
            aptx) echo "aptX" ;;
            aptx_hd) echo "aptX HD" ;;
            aptx_ll*) echo "aptX LL" ;;
            msbc) echo "mSBC" ;;
            faststream*) echo "FastStream" ;;
            lc3plus*) echo "LC3plus" ;;
            lc3_swb) echo "LC3-SWB" ;;
            opus*) echo "Opus" ;;
            *) echo "${CODEC}" | tr 'a-z' 'A-Z' ;;
        esac
    }
}

# The music (A2DP) codecs a device can switch between: PipeWire offers each as a profile of the device's card, named in
# its description ("High Fidelity Playback (A2DP Sink, codec AAC) (... priority: 19, available: yes)"). From pactl's
# card listing ($2) for address $1, one "profile<TAB>codec" line each, PipeWire's preferred (highest priority) first.
bt_codec_profiles() {
    echo "$2" | awk -v addr="$1" '
        /^Card #/ { a = "" }
        /api\.bluez5\.address = / { split($0, q, "\""); a = toupper(q[2]) }
        a == toupper(addr) && /^[[:space:]]+a2dp-sink[^:]*: .*codec [^)]*\).*available: yes/ {
            p = $1; sub(/:$/, "", p)
            c = $0; sub(/.*codec /, "", c); sub(/\).*/, "", c)
            r = $0; sub(/.*priority: /, "", r); sub(/[^0-9].*/, "", r)
            print r "\t" p "\t" c
        }' | sort -rn | cut -f2-
}

# Switch a connected device's music to codec $2 (a name as list prints it), through its card's profile
do_codec() {
    local DEV="$1" WANT="$2" CARDS PROFILE CARD
    if ! validate_mac_address "${DEV}"; then
        log_error "Invalid device address format"
        return 1
    fi
    CARDS=$(timeout 5 pactl list cards 2>/dev/null)
    PROFILE=$(bt_codec_profiles "${DEV}" "${CARDS}" | awk -F '\t' -v c="${WANT}" '$2 == c { print $1; exit }')
    if [ -z "${PROFILE}" ]; then
        log_error "${WANT} isn't offered for this device. Is it connected?"
        return 1
    fi
    CARD="bluez_card.$(echo "${DEV}" | tr ':' '_')"
    if ! timeout 10 pactl set-card-profile "${CARD}" "${PROFILE}"; then
        log_error "Couldn't switch to ${WANT}"
        return 1
    fi
    # The stream closes and reopens on the new codec, with no sink for a second or two (on a Thor, 2026-11-13):
    # return once it's back, so the caller's next list shows the new codec rather than none
    for _ in 1 2 3 4 5 6 7 8; do
        SINKS=$(timeout 5 pactl list sinks 2>/dev/null)
        if [ "$(bt_codec "${DEV}")" = "${WANT}" ]; then
            log_info "Switched ${DEV} to ${WANT}"
            return 0
        fi
        sleep 1
    done
    log_error "Switched to ${WANT}, but the sound hasn't started on it"
    return 1
}

# List paired devices
do_list() {
    # PipeWire's sinks, read once: a connected audio device's codec (none while Bluetooth audio isn't streaming)
    SINKS=$(timeout 5 pactl list sinks 2>/dev/null)
    CARDS=$(timeout 5 pactl list cards 2>/dev/null)
    find "${CACHE_PATH}/bluetooth" -type f -name info | while read -r FILE; do
        if grep -qE '^Trusted=true$' "${FILE}"; then
            DEVNAME=$(grep -E '^Name=' "${FILE}" | sed -e s+"^Name="++)
            DEVCLASS=$(grep -E '^Class=' "${FILE}" | sed -e s+"^Class="++)
            DEVADDR=$(basename "$(dirname "${FILE}")")

            DEVTYPE=""
            case "${DEVCLASS}" in
                "0x002508"|"0x000508") DEVTYPE="joystick" ;;
            esac

            # Check connection status
            INFO=$(timeout 5 bluetoothctl -- info "${DEVADDR}")
            if echo "${INFO}" | grep -q "Connected: yes"; then
                CONNECTED="yes"
            else
                CONNECTED="no"
            fi

            # Battery, while connected: BlueZ's own (BLE battery service; headphones through PipeWire's HFP
            # battery provider), else the kernel's for pads whose driver reads it (DualSense, DualShock 4, Switch
            # Pro: power_supply entries named after the address, in either case)
            BATTERY=""
            if [ "${CONNECTED}" = "yes" ]; then
                BATTERY=$(echo "${INFO}" | sed -n 's/^[[:space:]]*Battery Percentage: 0x[0-9a-fA-F]* (\([0-9]*\))$/\1/p' | head -1)
                if [ -z "${BATTERY}" ]; then
                    ADDR_LC=$(echo "${DEVADDR}" | tr 'A-F' 'a-f')
                    for PS in "${POWER_SUPPLY_PATH}"/*; do
                        case "$(basename "${PS}" | tr 'A-F' 'a-f')" in
                            *"${ADDR_LC}"*) [ -r "${PS}/capacity" ] && BATTERY=$(cat "${PS}/capacity") && break ;;
                        esac
                    done
                fi
            fi

            CODEC=""
            [ "${CONNECTED}" = "yes" ] && CODEC=$(bt_codec "${DEVADDR}")

            # The codecs it can switch to, best first, comma-separated (not with paste: on the Thor that's an
            # upload to a pastebin)
            CODECS=""
            [ "${CONNECTED}" = "yes" ] && CODECS=$(bt_codec_profiles "${DEVADDR}" "${CARDS}" | cut -f2 | tr '\n' ',' | sed 's/,$//')

            echo "<device id=\"${DEVADDR}\" name=\"${DEVNAME}\" type=\"${DEVTYPE}\" connected=\"${CONNECTED}\" battery=\"${BATTERY}\" codec=\"${CODEC}\" codecs=\"${CODECS}\" />"
        fi
    done
}

# Clean up device listing resources
cleanup_devlist() {
    local tail_pid

    # Stop the tail process if running
    if [ -f "${BT_LISTING_PID_FILE}" ]; then
        tail_pid=$(cat "${BT_LISTING_PID_FILE}")
        if [ -n "${tail_pid}" ]; then
            kill -15 "${tail_pid}" 2>/dev/null
        fi
        rm -f "${BT_LISTING_PID_FILE}"
    fi

    # Signal stop via control file
    echo "stop" > "${BT_CONTROL_FILE}"

    # Clean up files
    rm -f "${BT_LISTING_FILE}" "${BT_DEVICE_FILE}"
}

# Start device listing
do_devlist() {
    # Check if agent is running
    if ! check_agent_status; then
        log_error "Bluetooth agent is not running"
        return 1
    fi

    # Initialize files
    if ! > "${BT_DEVICE_FILE}"; then
        log_error "Cannot create device file"
        return 1
    fi

    if ! > "${BT_LISTING_FILE}"; then
        log_error "Cannot create listing file"
        return 1
    fi

    # Signal start via control file
    echo "start" > "${BT_CONTROL_FILE}"

    # Start monitoring in background
    tail -f "${BT_LISTING_FILE}" &
    echo $! > "${BT_LISTING_PID_FILE}"

    # Set up cleanup on script exit
    trap cleanup_devlist EXIT INT TERM

    # Wait for the tail process
    wait $(cat "${BT_LISTING_PID_FILE}")
}

# Stop device listing
do_stopdevlist() {
    cleanup_devlist
}

# Start a scan and return, for a caller that polls scan_list
do_scan_start() {
    if ! check_agent_status; then
        log_error "Bluetooth agent is not running"
        return 1
    fi

    > "${BT_LISTING_FILE}" || return 1
    echo "start" > "${BT_CONTROL_FILE}"
}

# The agent appends a line per event. Print each device's latest line, in the order first seen, leaving out
# devices that are gone or have no name yet: a nameless one can't be told apart on screen.
do_scan_list() {
    [ -f "${BT_LISTING_FILE}" ] || return 0
    awk '
        match($0, /id="[^"]*"/) {
            id = substr($0, RSTART, RLENGTH)
            if (!(id in last)) order[++n] = id
            last[id] = $0
        }
        END {
            for (i = 1; i <= n; i++)
                if (last[order[i]] !~ /status="removed"/ && last[order[i]] !~ /name="None"/)
                    print last[order[i]]
        }' "${BT_LISTING_FILE}"
}

# Remove a device
do_remove() {
    local DEV="$1"

    if ! validate_mac_address "${DEV}"; then
        log_error "Invalid device address format"
        return 1
    fi

    # Remove device using bluetoothctl
    (echo "untrust ${DEV}"; echo "remove ${DEV}") | bluetoothctl >/dev/null 2>&1

    # Remove device files
    find "${CACHE_PATH}/bluetooth" -name "${DEV}" -exec rm -rf {} +

    # Backup new configuration
    do_save
    log_info "Device ${DEV} removed successfully"
}

# Trust a device
do_trust() {
    local TRUSTDEV="$1"

    # Check if agent is running
    if ! check_agent_status; then
        log_error "Bluetooth agent is not running"
        return 1
    fi    # This was the problem - had } instead of fi

    # Validate input for device address
    if [ "${TRUSTDEV}" != "input" ]; then
        if ! validate_mac_address "${TRUSTDEV}"; then
            log_error "Invalid device address format"
            return 1
        fi
    fi

    # Write device to control file
    echo "${TRUSTDEV}" > "${BT_DEVICE_FILE}" || return 1

    # A message from an earlier attempt isn't this attempt's result
    rm -f "${BT_STATUS_FILE}"

    # The agent only pairs while it's discovering
    echo "start" > "${BT_CONTROL_FILE}"

    local LAST_MSG=""
    local NEW_MSG=""
    local N=60

    while [ $N -gt 0 ]; do
        if [ -f "${BT_STATUS_FILE}" ]; then
            NEW_MSG=$(cat "${BT_STATUS_FILE}")
            if [ "${LAST_MSG}" != "${NEW_MSG}" ]; then
                LAST_MSG="${NEW_MSG}"
                echo "${NEW_MSG}"
            fi
        fi

        if [ "${TRUSTDEV}" != "input" ]; then
            if do_list | grep -q "id=\"${TRUSTDEV}\""; then
                break
            fi
        fi

        sleep 1
        N=$((N-1))
    done

    # Done looking: stop the scan, and stop the agent acting on this device's later events
    echo "stop" > "${BT_CONTROL_FILE}"
    rm -f "${BT_DEVICE_FILE}"

    [ -n "${LAST_MSG}" ] || echo "No device found"

    # Quietly: the caller shows the last line of this output as the result
    do_save >/dev/null
}

# Enable bluetooth
do_enable() {
    set_setting controllers.bluetooth.enabled 1
    systemctl start bluetooth
    systemctl start bluetooth-agent

    # Wait for agent to start (up to 5 seconds)
    local n=0
    while [ $n -lt 10 ]; do
        if check_agent_status; then
            log_info "Bluetooth agent started successfully"
            return 0
        fi
        sleep 0.5
        n=$((n + 1))
    done

    log_error "Failed to start bluetooth agent"
    return 1
}

# Disable bluetooth
do_disable() {
    set_setting controllers.bluetooth.enabled 0
    systemctl stop bluetooth-agent
    systemctl stop bluetooth
    log_info "Bluetooth disabled"
}

# Connect to a device
do_connect() {
    local DEV="$1"

    if ! validate_mac_address "${DEV}"; then
        log_error "Invalid device address format"
        return 1
    fi

    if timeout 5 bluetoothctl -- info "${DEV}" | grep -q "Connected: yes"; then
        log_info "Device ${DEV} is already connected"
        return 0
    fi

    log_info "Attempting to connect to device ${DEV}..."
    if timeout 30 bluetoothctl -- connect "${DEV}"; then
        log_info "Successfully connected to device ${DEV}"
        return 0
    fi

    # The caller shows this last line: say what to do about it
    if rfkill list bluetooth | grep -q "Soft blocked: yes"; then
        log_error "The Bluetooth radio is off"
    else
        log_error "Couldn't connect. Is the device on and nearby?"
    fi
    return 1
}

# Disconnect from a device
do_disconnect() {
    local DEV="$1"

    if ! validate_mac_address "${DEV}"; then
        log_error "Invalid device address format"
        return 1
    fi

    if ! timeout 5 bluetoothctl -- info "${DEV}" | grep -q "Connected: yes"; then
        log_error "Device ${DEV} is not connected"
        return 1
    fi

    if timeout 15 bluetoothctl -- disconnect "${DEV}"; then
        log_info "Successfully disconnected device ${DEV}"
        return 0
    else
        log_error "Failed to disconnect device ${DEV}"
        return 1
    fi
}

# Main command processing
case "${ACTION}" in
    "list")
        do_list
        ;;
    "trust")
        [ -z "$2" ] && { do_help "${0}"; exit 1; }
        do_trust "$2"
        ;;
    "remove")
        [ -z "$2" ] && { do_help "${0}"; exit 1; }
        do_remove "$2"
        ;;
    "save")
        do_save
        ;;
    "restore")
        do_restore
        ;;
    "start_live_devices"|"live_devices")
        do_devlist
        ;;
    "stop_live_devices"|"scan_stop")
        do_stopdevlist
        ;;
    "scan_start")
        do_scan_start
        ;;
    "scan_list")
        do_scan_list
        ;;
    "enable")
        do_enable
        ;;
    "disable")
        do_disable
        ;;
    "connect")
        [ -z "$2" ] && { do_help "${0}"; exit 1; }
        do_connect "$2"
        ;;
    "disconnect")
        [ -z "$2" ] && { do_help "${0}"; exit 1; }
        do_disconnect "$2"
        ;;
    "codec")
        [ -z "$3" ] && { do_help "${0}"; exit 1; }
        do_codec "$2" "$3"
        ;;
    *)
        do_help "${0}"
        exit 1
        ;;
esac

exit 0
