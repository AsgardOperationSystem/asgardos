. /etc/profile

LOG="/var/log/boot.log"

### This script contains items that we only want to execute after a AsgardOS upgrade,
### or after a fresh installation.

### Items in this block should always run after updates.
################################################################################

### ROCKNIX -> AsgardOS (2026-10-30): state in /storage named after ROCKNIX. Settings keys rocknix.* became
### asgardos.*.
CFG=/storage/.config/system/configs/system.cfg
if [ -f "${CFG}" ] && grep -q '^rocknix\.' "${CFG}"; then
  echo "Migrate rocknix.* settings..." >>${LOG}
  sed -i 's/^rocknix\./asgardos./' "${CFG}"
fi
[ -f /storage/.config/system/configs/rocknix-boot.conf ] && [ ! -f /storage/.config/system/configs/asgardos-boot.conf ] &&
  mv /storage/.config/system/configs/rocknix-boot.conf /storage/.config/system/configs/asgardos-boot.conf
[ -e /storage/.cache/debug.rocknix ] && mv /storage/.cache/debug.rocknix /storage/.cache/debug.asgardos

echo "Rebuild library cache..." >>${LOG}
tocon "Rebuilding library cache..."
### Rebuild the library cache
rm -f /storage/.cache/ld.so.cache
ldconfig -X

echo "Sync configuration files..." >>${LOG}
tocon "Re-sync configuration files..."
### Sync configurations
if [ -d "/storage/.config/system/configs" ]
then
  EXCLUDE="--exclude=configs"
fi

### Remove and link es configs so they are managed with OS updates.
for es_cfg in es_features.cfg es_systems.cfg
do
  mv /storage/.config/emulationstation/${es_cfg} /storage/.config/emulationstation/last_${es_cfg} >/dev/null 2>&1
  ln -s /usr/config/emulationstation/${es_cfg} /storage/.config/emulationstation/${es_cfg}  >/dev/null 2>&1
done

rsync -a --delete ${EXCLUDE} /usr/config/system/ /storage/.config/system/
rsync -a --ignore-existing /usr/config/game /storage/.config/
rsync -a /usr/config/modules /storage/.config/

if [ -f "/storage/.config/emulationstation/resources/logo.png" ]
then
  rm -f /storage/.config/emulationstation/resources/logo.png
fi

echo "Sync modules..." >>${LOG}
tocon "Update tool modules..."
rsync -a /usr/config/modules/* /storage/.config/modules/
# AsgardOS: rsync keeps files the image no longer has; drop the tool entry that ROCKNIX named.
rm -f "/storage/.config/modules/Install ROCKNIX.sh" /storage/.config/modules/images/install-rocknix.svg

### Emulators' settings are the user's (UPD-4): a key the image adds reaches them, a value they have stays. A shipped
### value that has to change for existing users needs its own conversion below.
merge_new_keys() {  # merge_new_keys <shipped> <user>, for key=value and key = "value" files
  [ -f "${1}" ] || return 0
  if [ ! -s "${2}" ]; then
    cp -f "${1}" "${2}"
    return
  fi
  [ -z "$(tail -c1 "${2}")" ] || echo >>"${2}"
  awk -F= 'function key(s) { gsub(/[ \t]/, "", s); return s }
           NR == FNR { have[key($1)] = 1; next }
           { k = key($1) } k != "" && !(k in have) { print }' "${2}" "${1}" >>"${2}"
}
### A shipped value that was wrong changes only where the user still has that old value; one they set stays (UPD-4).
convert_value() {  # convert_value <file> <key> <old> <new>, for key=value and key = value lines; the spacing is kept
  [ -f "${1}" ] || return 0
  KEY="${2}" OLD="${3}" NEW="${4}" awk '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    { i = index($0, "=") }
    i && trim(substr($0, 1, i - 1)) == ENVIRON["KEY"] && trim(substr($0, i + 1)) == ENVIRON["OLD"] {
      v = substr($0, i + 1); match(v, /^[ \t]*/); print substr($0, 1, i) substr(v, 1, RLENGTH) ENVIRON["NEW"]; next }
    { print }' "${1}" >"${1}.new"
  if cmp -s "${1}" "${1}.new"; then rm -f "${1}.new"; else mv -f "${1}.new" "${1}"; fi
}
merge_new_keys /usr/config/retroarch/retroarch-core-options.cfg /storage/.config/retroarch/retroarch-core-options.cfg
rsync -a --ignore-existing /usr/config/melonDS /storage/.config/
merge_new_keys /usr/config/melonDS/melonDS.ini /storage/.config/melonDS/melonDS.ini

### Add cloud sync-related files if missing
echo "Update cloud sync files..." >>${LOG}
if [ -x "/usr/bin/cloud_sync_helper" ]; then
  # Use the helper script to properly merge configurations
  tocon "Updating cloud sync configuration..."
  /usr/bin/cloud_sync_helper ${LOG}
else
  # Fall back to the simple copy if helper is not available
  tocon "Updating cloud sync files..."
  # Copy default cloud sync files if they don't exist
  for config_file in cloud_sync-rules.txt.defaults cloud_sync.conf.defaults; do
    if [ -f "/usr/config/${config_file}" ]; then
      rsync --ignore-existing /usr/config/${config_file} /storage/.config/
    fi
  done
  # Also copy the main config file if it doesn't exist
  if [ -f "/usr/config/cloud_sync.conf" ]; then
    rsync --ignore-existing /usr/config/cloud_sync.conf /storage/.config/
    # Always update defaults file to ensure latest version
    rsync /usr/config/cloud_sync.conf.defaults /storage/.config/
  fi
fi

### Sync locale data
tocon "Re-sync locale data..."
rsync -a --delete /usr/config/locale/* /storage/.config/locale/ >>/var/log/configure.log 2>&1
rm -rf /storage/.config/emulationstation/locale >>/var/log/configure.log 2>&1 ||:
ln -sf /usr/share/locale /storage/.config/emulationstation/locale >>/var/log/configure.log 2>&1 ||:

### Handle assets folder for ppsspp v1.20+ upgrade
if [ ! -d "/storage/.config/ppsspp/assets/ui_images" ]
then
  rsync -a --delete /usr/config/ppsspp/assets/* /storage/.config/ppsspp/assets/
fi

### Fix Japanese language bug
if [ ! -e "/storage/.config/ppsspp/assets/NotoSansJP-Regular.ttf" ]
then
  cd /storage/.config/ppsspp/assets
  cp /usr/config/ppsspp/assets/NotoSansJP-Regular.ttf .
  ln -s NotoSansJP-Regular.ttf Roboto-Condensed.ttf
  cd -
fi

### Add items below this line that are safe to remove after a period of time.
################################################################################

# DraStic's controls were numbered for the raw AYN pad, not the virtual DualSense games see (GAME-9, GAME-11): DS Start
# and Select sat on R2 and L2, the d-pad on L3/R3, Home opened DraStic's menu and R3 didn't press the touch cursor.
DRASTIC_CFG=/storage/.config/drastic/config/drastic.cfg
for c in a:UP:1035:105 a:DOWN:1036:107 a:LEFT:1037:106 a:RIGHT:1038:104 a:UI_UP:1035:105 a:UI_DOWN:1036:107 \
         a:UI_LEFT:1037:106 a:UI_RIGHT:1038:104 a:MENU:1032:65535 a:SWAP_SCREENS:1039:109 \
         b:START:1031:1033 b:SELECT:1030:1032 b:TOUCH_CURSOR_PRESS:1034:1036; do
  IFS=: read -r set name old new <<<"${c}"
  convert_value "${DRASTIC_CFG}" "controls_${set}[CONTROL_INDEX_${name}]" "${old}" "${new}"
done
for c in up:i down:k left:j right:h; do  # the d-pad reaches DraStic as keys, through gptokeyb
  convert_value /storage/.config/drastic/drastic.gptk "${c%%:*}" '\\' "${c##*:}"
done

# DuckStation's right stick had left and right swapped.
convert_value /storage/.config/duckstation/settings.ini RLeft SDL-0/+RightX SDL-0/-RightX
convert_value /storage/.config/duckstation/settings.ini RRight SDL-0/-RightX SDL-0/+RightX

# AetherSX2: Home also pressed the PS2's Analog button, so every tap of it flipped the pad's analog mode, and Home's Esc
# (thor_ayn_button.py) wasn't bound to its pause menu, as it is in ARMSX2's.
AETHERSX2_INI=/storage/.config/aethersx2/inis/PCSX2.ini
convert_value "${AETHERSX2_INI}" Analog SDL-0/Guide ""
if [ -f "${AETHERSX2_INI}" ] && ! grep -q "^OpenPauseMenu = Keyboard/Escape$" "${AETHERSX2_INI}"; then
  sed -i '/^\[Hotkeys\]$/a OpenPauseMenu = Keyboard/Escape' "${AETHERSX2_INI}"
fi

# Eden and Eden Duo had no motion bound (Eden's default puts it on the keys 7 and 8): now asgard-motiond's DSU server.
EDEN_DSU='"engine:cemuhookudp,guid:0000000000000000000000007f000001,port:26760,pad:0,motion:0"'
for cfg in /storage/.config/eden/qt-config.ini /storage/.config/eden/sdl2-config.ini; do
  for player in 0 8; do
    convert_value "${cfg}" "player_${player}_motionleft" '"engine:keyboard,code:55,toggle:0"' "${EDEN_DSU}"
    convert_value "${cfg}" "player_${player}_motionright" '"engine:keyboard,code:56,toggle:0"' "${EDEN_DSU}"
  done
done

# Dolphin's Classic Controller profile had the Xbox layout (A on the Thor's B): now the printed letters (GAME-11).
for c in A:S:E B:E:S X:W:N Y:N:W; do
  IFS=: read -r button old new <<<"${c}"
  convert_value /storage/.config/dolphin-emu/WiiControllerProfiles/classic.ini "Classic/Buttons/${button}" "\`Button ${old}\`" \
    "\`Button ${new}\`"
done

# Flycast put the Dreamcast's A on the Thor's B and Y on X: now the printed letters (GAME-11). Only the [digital] binds
# hold these values, so the other sections' bindN keys are left alone.
for pad in "DualSense Wireless Controller" "DualSense Edge Wireless Controller"; do
  for c in bind0:0:btn_a:btn_b bind1:1:btn_b:btn_a bind2:2:btn_y:btn_x bind3:3:btn_x:btn_y; do
    IFS=: read -r key button old new <<<"${c}"
    convert_value "/storage/.config/flycast/mappings/SDL_Sony Interactive Entertainment ${pad}.cfg" "${key}" \
      "${button}:${old}" "${button}:${new}"
  done
done

# mupen64plus's hotkeys were numbered for an Xbox pad: on the virtual DualSense their modifier, button 6, is L2 (the
# N64's Z), so Z+A reset the game and Z+L/R loaded or saved a state. Home (button 10) is the modifier now (GAME-11).
for c in Stop:J0B7/B8:J0B10/B9 "Save State:J0B6/B5:J0B10/B5" "Load State:J0B6/B4:J0B10/B4" Reset:J0B6/B0:J0B10/B0 \
         Screenshot:J0B6/B3:J0B10/B3 Pause:J0B12/B1:J0B10/B1; do
  IFS=: read -r name old new <<<"${c}"
  convert_value /storage/.config/mupen64plus/mupen64plus.cfg "Joy Mapping ${name}" "\"${old}\"" "\"${new}\""
done

# Home tapped alone is Asgard's in-game menu (MENU-1, GAME-11), but some emulators also bound it alone, so the tap
# pressed the game's own button too: Dolphin's Wii HOME and Triforce coin move to Home+Select, Azahar's 3DS HOME and
# RPCS3's PS button are unbound (neither can bind a combo).
for profile in classic hremote nunchuck vremote; do
  for key in Buttons/Home Classic/Buttons/Home; do
    convert_value "/storage/.config/dolphin-emu/WiiControllerProfiles/${profile}.ini" "${key}" '`Guide`' '`Guide` & `Back`'
  done
done
for profile in east.inline east.stacked south.inline south.stacked; do
  convert_value "/storage/.config/dolphin-emu/GamecubeControllerProfiles/GCPadNew.ini.${profile}" Triforce/Coin '`Guide`' \
    '`Guide` & `Back`'
done
convert_value /storage/.config/azahar/qt-config.ini 'profiles\1\button_home' \
  '"button:10,engine:sdl,guid:0300fd574c050000e60c000011810000,port:0"' '"engine:null"'
RPCS3_PAD=/storage/.config/rpcs3/input_configs/global/Default.yml
if [ -f "${RPCS3_PAD}" ]; then
  sed -i 's/^    PS Button: Guide$/    PS Button: ""/' "${RPCS3_PAD}"
fi

# Dolphin's Wii remote had no motion bound: the shipped profiles gained IMU lines on asgard-motiond's DSU server. An
# install's copies of them (not custom.ini, the user's own) get the lines the image's copy has, if they have none.
for profile in classic hremote nunchuck vremote; do
  user="/storage/.config/dolphin-emu/WiiControllerProfiles/${profile}.ini"
  [ -f "${user}" ] && ! grep -q "^IMU" "${user}" || continue
  grep "^IMU" "/usr/config/dolphin-emu/WiiControllerProfiles/${profile}.ini" >"${user}.imu" || { rm -f "${user}.imu"; continue; }
  awk -v imu="${user}.imu" '{ print } /^Device = / && !done { while ((getline l < imu) > 0) print l; done = 1 }' \
    "${user}" >"${user}.new" && mv -f "${user}.new" "${user}"
  rm -f "${user}.imu"
done

# Copy aethersx2 bios files for armsx2 for convenience
if [ -d "/storage/roms/bios/aethersx2/bios" ] && [ ! -d "/storage/roms/bios/armsx2" ]; then
  cp -rf /storage/roms/bios/aethersx2/bios /storage/roms/bios/armsx2
fi

# Set the flag to enable batteryplus capacity reporting if it doesn't already exist
grep -q "^system\.batteryplus\.enabled=" /storage/.config/system/configs/system.cfg ||
    sed -i '$ a\system.batteryplus.enabled=1' /storage/.config/system/configs/system.cfg

# Defaults the image's system.cfg gained after a user's install: added once each, so one the user clears later stays
# cleared (CFG-1). The list in defaults-applied says which were added.
DEFAULTS_DONE=/storage/.config/asgard/defaults-applied
add_default_once() {   # <name> <key> <value>
  grep -qx "$1" "$DEFAULTS_DONE" 2>/dev/null && return
  grep -q "^${2//./\\.}=" /storage/.config/system/configs/system.cfg ||
    sed -i "\$ a\\$2=$3" /storage/.config/system/configs/system.cfg   # on its own line, even after a last line with no newline
  mkdir -p /storage/.config/asgard && echo "$1" >> "$DEFAULTS_DONE"
}
# Switch games run at 60 fps at most: the top screen at 60 Hz halves its presents and scanout for nothing lost
add_default_once switch-top-60hz switch.top_refresh 60

# Dolphin controller profiles moved from evdev to SDL bindings. Existing copies
# in /storage name "Microsoft X-Box 360 pad", the virtual pad gptokeyb used to
# create, and Dolphin no longer starts gptokeyb, so they would bind nothing.
# The launch scripts only seed these when absent, so refresh them here.
DOLPHIN_CFG="/storage/.config/dolphin-emu"
# Checked against the shipped profiles only, never the backups written below.
# Those profiles have since been renamed, so the rsync no longer overwrites the
# names tested here; the cleanup below is what keeps this from firing twice.
if grep -qs "Microsoft X-Box 360 pad" \
     "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.south" \
     "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.east" \
     "${DOLPHIN_CFG}/Hotkeys.ini"; then
  tocon "Updating Dolphin controller profiles for SDL..."
  # A custom profile cannot be carried over, so keep a copy before replacing it.
  if [ -f "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.custom" ]; then
    mv -f "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.custom" \
          "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.custom.evdev"
  fi
  if [ -f "${DOLPHIN_CFG}/WiiControllerProfiles/custom.ini" ]; then
    mv -f "${DOLPHIN_CFG}/WiiControllerProfiles/custom.ini" \
          "${DOLPHIN_CFG}/WiiControllerProfiles/custom.ini.evdev"
  fi
  rsync -a /usr/config/dolphin-emu/Hotkeys.ini \
           /usr/config/dolphin-emu/GamecubeControllerProfiles \
           /usr/config/dolphin-emu/WiiControllerProfiles "${DOLPHIN_CFG}/"
  # Regenerated from the profiles above on the next launch.
  rm -f "${DOLPHIN_CFG}/GCPadNew.ini" "${DOLPHIN_CFG}/WiimoteNew.ini"
fi

# The GC profiles gained stacked/inline shoulder variants and are now named for
# the layout they target, so the old single-layout files are dead. They must go:
# the SDL migration above tests them by name, and nothing overwrites them any
# more, so leaving them behind re-fires that block on every later update and
# overwrites the .evdev backup it took the first time.
rm -f "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.east" \
      "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.south"

# Turning off the display via DPMS in asgardos-fake-suspend is problematic on
# some platforms, so delete the setting. It is disabled by default, but can
# be used on an opt-in basis
sed -i "/system.suspend.dpms/d" /storage/.config/system/configs/system.cfg

# The distro sysctls moved from /storage/.config/sysctl.d into /usr/lib/sysctl.d/60-asgardos.conf, drop untouched copies.
for conf in rocknix.conf:0c0d12bea1678cb7a60de7f33f874641 99-rocknix-networking.conf:6f1576b68b29e85517a34b87bb222282
do
  file="/storage/.config/sysctl.d/${conf%%:*}"
  [ "$(md5sum "${file}" 2>/dev/null | cut -d' ' -f1)" = "${conf##*:}" ] && rm -f "${file}"
done

# The EQ chains have one fixed shape since SND-7, so the menu can change them live. A 60-asgard-eq.conf written before
# that has the old shape: write it again from eq.json, and restart PipeWire only if it changed (at boot, no game runs).
if [ -f /storage/.config/pipewire/pipewire.conf.d/60-asgard-eq.conf ]; then
  python3 /usr/share/asgard/asgard-eq.py regen >>${LOG} 2>&1
fi
