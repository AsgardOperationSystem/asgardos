#!/bin/bash
# Asgard boot tuning for the AYN Thor. Knobs are system.cfg keys, so asgard.yml can set them too.
. /etc/profile.d/001-functions

# The read-only image has no /etc/hostname (systemd falls back to AsgardOS); apply system.hostname.
H=$(get_setting system.hostname)
[ -n "$H" ] && hostname "$H"

# USB autosuspend so DWC3 + PHY can idle (udev covers a600000.usb only).
for u in /sys/bus/platform/devices/*.usb/power/control; do echo auto > "$u" 2>/dev/null; done

# Airplane mode (Thor Panel): every radio stays off across reboots until it's turned off there.
[ "$(get_setting asgard.airplane)" = "1" ] && rfkill block all

# Steam: ROCKNIX's Steam system lists .desktop files, and Steam.desktop opens Steam itself (Big Picture). Steam
# writes it only after it has run, so on a fresh install there was no Steam tile to start it from.
if [ -x /usr/bin/start_steam.sh ] && [ ! -e /storage/.local/share/applications/Steam.desktop ]; then
  mkdir -p /storage/.local/share/applications
  printf '[Desktop Entry]\nType=Application\nName=Steam\nExec=steam\n' > /storage/.local/share/applications/Steam.desktop
fi

# Tools > Firefox: the music system lists its folder's .sh scripts (runemu.sh runs them), like "Start Music Player.sh".
mkdir -p /storage/.config/gmu/playlists
ln -sfn /usr/bin/start_firefox.sh /storage/.config/gmu/playlists/Firefox.sh
# It inherits the music system's profile (little cores only, capped): video stuttered. All cores, full clocks, per
# game (asgard-perf-profile.sh); added once, so Thor Settings can still change them.
CFG=/storage/.config/system/configs/system.cfg
for kv in cpu_cap_little=100 cpu_cap_mid=100 cpu_cap_prime=100; do
  grep -q "^music\[\"Firefox.sh\"\]\.${kv%%=*}=" "$CFG" || echo "music[\"Firefox.sh\"].$kv" >> "$CFG"
done
# Tools > Terminal (QTerminal, keyboard on the bottom screen), Moonlight (moonlight-qt) and Files (Asgard Files).
# Moonlight decodes video: all cores, full clocks, as Firefox.
ln -sfn /usr/share/asgard/start_terminal.sh /storage/.config/gmu/playlists/Terminal.sh
ln -sfn /usr/bin/start_moonlight-qt.sh /storage/.config/gmu/playlists/Moonlight.sh
ln -sfn /usr/bin/start_asgard-files.sh /storage/.config/gmu/playlists/Files.sh
for kv in cpu_cap_little=100 cpu_cap_mid=100 cpu_cap_prime=100; do
  grep -q "^music\[\"Moonlight.sh\"\]\.${kv%%=*}=" "$CFG" || echo "music[\"Moonlight.sh\"].$kv" >> "$CFG"
done
# Home starts before this script: the first boot with new entries, it had scanned without them.
[ -p /run/asgard-home.cmd ] && timeout 2 sh -c 'echo rescan > /run/asgard-home.cmd'   # no reader: don't hang boot

# A fixed fan speed (asgard.fan_manual) is applied by fancontrol.service itself (asgard-fan.sh).

# CPU clock cap per core type (Settings > Performance), percent of each cluster's top clock.
/usr/share/asgard/asgard-cpu-cap.sh
# Gyro in the menu (Settings > Performance > Gyro, asgard.motion); games set their own (asgard-perf-profile.sh).
/usr/share/asgard/asgard-perf-profile.sh motion
