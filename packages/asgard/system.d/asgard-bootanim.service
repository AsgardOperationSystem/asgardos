[Unit]
Description=Asgard boot animation (until sway takes the display)
DefaultDependencies=no
After=systemd-udevd.service
# sway stops it before starting (ExecStartPre in asgard-rotate.conf): the animation holds the display sway is
# about to take. Not Conflicts=sway.service: at boot both are in one transaction, and systemd dropped this unit.
Before=sway.service

[Service]
# Drawn through KMS on the top panel; without DRM master it falls back to /dev/fb0 and switches this backlight off.
ExecStart=/usr/bin/asgardos-splash --animate /sys/class/backlight/ae94000.dsi.0

[Install]
WantedBy=sysinit.target
