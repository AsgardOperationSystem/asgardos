+// Asgard: a fixed colour matrix per screen from /storage/.config/asgard/ctm/<connector> (nine numbers, row-major,
+// out = M * in), for a panel whose primaries differ (the Thor's bottom red is orange next to the top's). Reloaded
+// when the file changes; no file, no matrix. ponytail: one stat() per commit.
+uint32_t drm_connector_ctm(struct wlr_drm_connector *conn) {
+	struct wlr_drm_crtc *crtc = conn->crtc;
+	char path[96];
+	snprintf(path, sizeof(path), "/storage/.config/asgard/ctm/%s", conn->name);
+	struct stat st;
+	bool exists = stat(path, &st) == 0;
+	if (!exists && crtc->ctm == 0) {
+		return 0;
+	}
+	if (exists && st.st_mtim.tv_sec == crtc->ctm_mtime.tv_sec &&
+			st.st_mtim.tv_nsec == crtc->ctm_mtime.tv_nsec) {
+		return crtc->ctm;
+	}
+	if (crtc->ctm != 0) {
+		drmModeDestroyPropertyBlob(conn->backend->fd, crtc->ctm);
+		crtc->ctm = 0;
+	}
+	crtc->ctm_mtime = exists ? st.st_mtim : (struct timespec){0};
+	if (!exists) {
+		return 0;
+	}
+	double m[9];
+	int n = 0;
+	FILE *f = fopen(path, "r");
+	if (f != NULL) {
+		while (n < 9 && fscanf(f, "%lf", &m[n]) == 1) {
+			n++;
+		}
+		fclose(f);
+	}
+	if (n != 9) {
+		wlr_log(WLR_ERROR, "%s: want 9 numbers, got %d", path, n);
+		return 0;
+	}
+	struct drm_color_ctm ctm;
+	for (int i = 0; i < 9; i++) {  // S31.32 sign-magnitude
+		double v = m[i] < 0 ? -m[i] : m[i];
+		ctm.matrix[i] = (uint64_t)(v * 4294967296.0 + 0.5) | (m[i] < 0 ? 1ULL << 63 : 0);
+	}
+	if (drmModeCreatePropertyBlob(conn->backend->fd, &ctm, sizeof(ctm), &crtc->ctm) != 0) {
+		wlr_log_errno(WLR_ERROR, "%s: failed to create the CTM blob", conn->name);
+		crtc->ctm = 0;
+	}
+	wlr_log(WLR_INFO, "%s: colour matrix from %s", conn->name, path);
+	return crtc->ctm;
+}
